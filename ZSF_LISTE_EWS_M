FORM errore_interno.
  CASE gv_tip_err.
    WHEN 'L'. "un errore sull'inserimento della lista
      CONCATENATE 'Errore interno sull''inserimento della lista' gv_num_err INTO gv_text_lista SEPARATED BY space.
    WHEN 'O'. "errore sull'inserimento dell'ordinativo
      CONCATENATE 'Errore interno sull''inserimento dell''ordinativo' gv_num_err INTO gv_text_lista SEPARATED BY space.
  ENDCASE.
  CONCATENATE 'Utente:' sy-uname INTO gv_utente_1100 SEPARATED BY space.
  WRITE sy-datum TO gv_data_1100.
  CONCATENATE 'Data:' gv_data_1100 INTO gv_data_1100 SEPARATED BY space.
  gv_num_ord_da_trasmettere_1100 = 'Ripetere l''esecuzione'.

*fieldcatalog

  gs_fieldcat_response_1100-fieldname = 'ERRORE_INTERNO'.
  gs_fieldcat_response_1100-scrtext_l = 'ERRORE'.
  gs_fieldcat_response_1100-selddictxt = 'L'.
  APPEND gs_fieldcat_response_1100 TO gt_fieldcat_response_1100.

  gs_fieldcat_response_1100-fieldname = 'NUM_ERR_INT'.
  gs_fieldcat_response_1100-scrtext_l = 'NUMERO ERRORE'.
  gs_fieldcat_response_1100-selddictxt = 'L'.
  APPEND gs_fieldcat_response_1100 TO gt_fieldcat_response_1100.

* tabella interna alv 1100 dell'errore
  CASE gv_tip_err.
    WHEN 'L'.
      gs_alv_response_1100-errore_interno = 'Errore interno sulla lista'.
    WHEN 'O'.
      gs_alv_response_1100-errore_interno = 'Errore interno sull''ordinativo'.
  ENDCASE.
  gs_alv_response_1100-num_err_int    = gv_num_err.

  APPEND gs_alv_response_1100 TO gt_alv_response_1100.




ENDFORM.                    " ERRORE_INTERNO
