************************************************************************************
*    ESTRAZIONE DATI MANDATO ASSOCIATO                                             *
************************************************************************************
  CALL FUNCTION 'Z_GET_ORDINATIVI_ASSOCIATI'
    EXPORTING
      numero_ordinativo    = gs_ord_ews-belnr
      tipo_ordinativo      = 'R'
      esercizio            = gs_ord_ews-gjahr
    IMPORTING
      ordinativi_associati = lt_associata
*     N_ORD_ASSOCIATI      =
    .
  READ TABLE lt_associata INTO ls_associata INDEX 1.
************************************************************************************
*    POPOLAZIONE ALV CON CAMPI ASSOCIATI                                           *
************************************************************************************


  SELECT SINGLE * FROM zfm_rev_t                     "#EC CI_SEL_NESTED
    INTO @ls_zfm_rev_t                        "#EC CI_ALL_FIELDS_NEEDED
     WHERE fikrs        EQ @p_fikrs
  AND   gjahr        EQ @gs_ord_ews-gjahr
  AND   n_rev        EQ @gs_ord_ews-belnr.
  IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

*  SELECT SINGLE * FROM zfm_liq_t                     "#EC CI_SEL_NESTED
*    INTO @ls_zfm_liq_t                        "#EC CI_ALL_FIELDS_NEEDED
*    WHERE fikrs        EQ @p_fikrs
*  AND   anno_mandato EQ @ls_associata-aa_ord
*  AND   nr_mandato   EQ @ls_associata-n_ord.

  SELECT  * FROM zfm_liq_t   UP TO 1 ROWS            "#EC CI_SEL_NESTED
INTO @ls_zfm_liq_t                            "#EC CI_ALL_FIELDS_NEEDED
WHERE fikrs        EQ @p_fikrs
AND   anno_mandato EQ @ls_associata-aa_ord
AND   nr_mandato   EQ @ls_associata-n_ord
ORDER BY PRIMARY KEY      .
  ENDSELECT.


  IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

  SELECT SINGLE * FROM zfm_liq_r                     "#EC CI_SEL_NESTED
    INTO @ls_zfm_liq_r                        "#EC CI_ALL_FIELDS_NEEDED
    WHERE fikrs   EQ @p_fikrs
