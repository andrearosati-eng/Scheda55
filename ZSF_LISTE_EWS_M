*
      <wa>-variazione_testata  = 'Y'.

      IF v_stato = 'D'.
        <wa>-zsftipolis      = 'U'.
        <wa>-dcm_operation   = 'OVERWRITE'.
*        IF v_data_firma IS INITIAL.
*          <wa>-crud            = 'INS'.
*        ELSE.
        <wa>-crud            = 'VAR'.
        IF v_opi EQ 4 .
          <wa>-stato_opi = 'RICEVUTO_DA_BT'."arosati 08.01.2023
        ELSE.
          <wa>-stato_opi = ''.
        ENDIF.
*        ENDIF.
        IF ( v_opi EQ 1 OR v_opi EQ 7 ) AND v_data_firma IS NOT INITIAL.
*          <wa>-zsftipolis      = 'I'.
          <wa>-zsftipolis      = 'U'."arosati 13.03.2024

          <wa>-variazione_testata = 'N'.
          <wa>-crud            = 'INS'.
          <wa>-stato_opi = 'RIFIUTATO_DA_BT'."arosati 08.01.2023

*          <wa>-dcm_operation   = 'NEW'.
