FORM liq_da_compensazione USING p_gs_zmel_docu_detail TYPE zmel_docu_detail.

  DATA: lt_rev_assoc TYPE z_t_ordinativi,
        ls_rev_assoc LIKE LINE OF lt_rev_assoc.
  DATA: lt_rev_t TYPE STANDARD TABLE OF zfm_rev_t,
        ls_rev_t TYPE zfm_rev_t.
  DATA: imp_rev_tot	TYPE zimp_rev.

  DATA: lv_gjahr TYPE gjahr,
        lv_ord   TYPE znum_ord.

  CASE p_gs_zmel_docu_detail-tipo_ordinativo.

    WHEN 'M'.
      lv_ord   = p_gs_zmel_docu_detail-numero_ordinativo.
      lv_gjahr = p_gs_zmel_docu_detail-anno_ordinativo.
**Carica reversali associate
      CALL FUNCTION 'Z_GET_ORDINATIVI_ASSOCIATI'
        EXPORTING
          numero_ordinativo    = lv_ord
          tipo_ordinativo      = 'M'
          esercizio            = lv_gjahr
        IMPORTING
          ordinativi_associati = lt_rev_assoc.

      LOOP AT lt_rev_assoc INTO ls_rev_assoc.      "#EC CI_LOOP_INTO_WA
        CLEAR ls_rev_t.
*        SELECT SINGLE * FROM zfm_rev_t               "#EC CI_SEL_NESTED
*          INTO @ls_rev_t                      "#EC CI_ALL_FIELDS_NEEDED
*          WHERE fikrs EQ @p_fikrs
*            AND gjahr EQ @ls_rev_assoc-aa_ord
*            AND n_rev EQ @ls_rev_assoc-n_ord.

        SELECT * FROM zfm_rev_t    UP TO 1 ROWS      "#EC CI_SEL_NESTED
    INTO @ls_rev_t                            "#EC CI_ALL_FIELDS_NEEDED
    WHERE fikrs EQ @p_fikrs
      AND gjahr EQ @ls_rev_assoc-aa_ord
      AND n_rev EQ @ls_rev_assoc-n_ord
ORDER BY PRIMARY KEY      .
        ENDSELECT.


        IF sy-subrc EQ 0.
          imp_rev_tot = imp_rev_tot + ls_rev_t-imp_rev.
          APPEND ls_rev_t TO lt_rev_t.
        ENDIF.
      ENDLOOP.

      IF p_gs_zmel_docu_detail-wtjhr EQ imp_rev_tot.
        APPEND LINES OF lt_rev_t TO gt_rev_compensate.
        p_gs_zmel_docu_detail-zzmtpag                  = TEXT-033. "COMPENSAZIONE
        p_gs_zmel_docu_detail-zzimbol                  = TEXT-034. "ESENTE BOLLO
        p_gs_zmel_docu_detail-causa_esenzione_bollo    = TEXT-035. "MANDATO CON REVERSALI ASSOCIATE
        p_gs_zmel_docu_detail-coordinate_conto_estero  = ' '.
        p_gs_zmel_docu_detail-tipo_pagamento_estero    = ' '.
        p_gs_zmel_docu_detail-zzmtpag_iban             = ' '.
      ENDIF.

    WHEN 'R'.

      READ TABLE gt_rev_compensate WITH KEY n_rev = p_gs_zmel_docu_detail-numero_ordinativo TRANSPORTING NO FIELDS.
      IF sy-subrc EQ 0.
        p_gs_zmel_docu_detail-zzmtpag                  = TEXT-033. "COMPENSAZIONE
        p_gs_zmel_docu_detail-zzimbol                  = TEXT-034. "ESENTE BOLLO
        p_gs_zmel_docu_detail-causa_esenzione_bollo    = TEXT-036. "RITENUTE ASSOCIATE A MANDATI
        p_gs_zmel_docu_detail-coordinate_conto_estero  = ' '.
        p_gs_zmel_docu_detail-tipo_pagamento_estero    = ' '.
        p_gs_zmel_docu_detail-zzmtpag_iban             = ' '.
      ENDIF.
  ENDCASE.


ENDFORM.                    " LIQ_DA_COMPENSAZIONE
