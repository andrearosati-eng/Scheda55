*          INTO (@v_stato, @v_data_firma)
*          WHERE n_rev EQ @<wa>-belnr
*          AND   gjahr EQ @<wa>-gjahr.

        SELECT SINGLE stato, data_firma, stato_opi FROM zfm_rev_t INNER JOIN zfm_rev_r
