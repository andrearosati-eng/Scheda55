FORM call_pgm_quiet    USING p_mandato
                             p_gjahr
                             p_fikrs.

*  CHECK 1 = 2.

  RANGES: r_mandat       FOR zvfm_liq_t_r-nr_mandato,
          r_nr_ben       FOR zvfm_liq_t_r-num_ben.

  DATA: va_jobname  LIKE tbtcjob-jobname,
        va_jobcount LIKE tbtcjob-jobcount.

  REFRESH: r_mandat, r_nr_ben . CLEAR: r_mandat, r_nr_ben .
  r_mandat-sign          = 'I'.
  r_mandat-option        = 'EQ'.
  r_mandat-low           = p_mandato.
  APPEND r_mandat.

  CONCATENATE 'ZFM_QUIET_PAG' r_mandat-low
         INTO va_jobname SEPARATED BY '_'.
  CONDENSE va_jobname.

  CALL FUNCTION 'JOB_OPEN'
    EXPORTING
      jobname          = va_jobname
    IMPORTING
      jobcount         = va_jobcount
    EXCEPTIONS
      cant_create_job  = 1
      invalid_job_data = 2
      jobname_missing  = 3
      OTHERS           = 4.

  IF sy-subrc = 0.
    SUBMIT zfm_quiet_pagamenti
           WITH p_fikrs   EQ '1000'
           WITH p_aa_liq  EQ sy-datum(4)
           WITH s_mandat  IN r_mandat
           WITH s_nr_ben  IN r_nr_ben
           WITH prgg      EQ 'X'
           WITH fre       EQ ' '
       VIA JOB va_jobname
       NUMBER  va_jobcount
          AND RETURN.
    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    CALL FUNCTION 'JOB_CLOSE'
      EXPORTING
        jobcount             = va_jobcount
        jobname              = va_jobname
        strtimmed            = 'X'
      EXCEPTIONS
        cant_start_immediate = 1
        invalid_startdate    = 2
        jobname_missing      = 3
        job_close_failed     = 4
        job_nosteps          = 5
        job_notex            = 6
        lock_failed          = 7
        invalid_target       = 8
        OTHERS               = 9.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

  ENDIF.

  COMMIT WORK AND WAIT.


ENDFORM.                    "call_pgm_quiet
