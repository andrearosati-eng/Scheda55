  LOOP AT lt_associate INTO ls_associate.                "#EC CI_NESTED
    CLEAR gs_alv_out.
    gs_ord_ews-belnr = ls_associate-n_ord.
    gs_ord_ews-blart = ls_associate-t_ord.
    gs_ord_ews-gjahr = ls_associate-gjahr.
