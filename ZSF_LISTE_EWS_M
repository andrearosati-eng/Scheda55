          WHERE zfm_mand_t~nr_mandato   EQ @<wa>-belnr
          AND   zfm_mand_t~anno_mandato EQ @<wa>-gjahr.
        IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA
