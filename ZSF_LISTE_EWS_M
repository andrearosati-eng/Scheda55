FORM call_pgm_incassi  USING    p_rev_t TYPE zfm_rev_t.

  CHECK p_rev_t-tipo_rev = 'S' AND ( p_rev_t-zsfstlista = 'LF' ). "OR p_rev_t-zsfstlista = 'LE' ).

  RANGES: r_reversale    FOR  zfm_rev_t-n_rev.
  RANGES: r_tiporev      FOR  zfm_rev_t-tipo_rev.

  DATA: va_jobname  LIKE tbtcjob-jobname,
        va_jobcount LIKE tbtcjob-jobcount.

  REFRESH r_reversale. CLEAR r_reversale.
  r_reversale-sign          = 'I'.
  r_reversale-option        = 'EQ'.
  r_reversale-low           = p_rev_t-n_rev.
  APPEND r_reversale.

  REFRESH r_tiporev.   CLEAR r_tiporev.
  r_tiporev-sign            = 'I'.
  r_tiporev-option          = 'EQ'.
  r_tiporev-low             = p_rev_t-tipo_rev.
  APPEND r_tiporev.

  CONCATENATE 'ZFM_REGISTRA_INCASSI' p_rev_t-n_rev
         INTO va_jobname SEPARATED BY '_'.
  CONDENSE va_jobname.

  CALL FUNCTION 'JOB_OPEN'
    EXPORTING
      jobname          = va_jobname
    IMPORTING
      jobcount         = va_jobcount
    EXCEPTIONS
      cant_create_job  = 1
      invalid_job_data = 2
      jobname_missing  = 3
      OTHERS           = 4.
  IF sy-subrc = 0.

    SUBMIT zfm_registra_incassi
           WITH p_fikrs  EQ p_rev_t-fikrs
*           WITH p_gjahr  EQ sy-datum(4) "Del GM040222
           WITH p_gjahr  EQ p_rev_t-gjahr "Ins GM040222
           WITH s_t_rev  IN r_tiporev
           WITH s_n_rev  IN r_reversale
           WITH p_stlist EQ p_rev_t-zsfstlista
           WITH prgg     EQ 'X'
           WITH fre      EQ ' '
         VIA JOB va_jobname
         NUMBER  va_jobcount
            AND RETURN.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    CALL FUNCTION 'JOB_CLOSE'
      EXPORTING
        jobcount             = va_jobcount
        jobname              = va_jobname
        strtimmed            = 'X'
      EXCEPTIONS
        cant_start_immediate = 1
        invalid_startdate    = 2
        jobname_missing      = 3
        job_close_failed     = 4
        job_nosteps          = 5
        job_notex            = 6
        lock_failed          = 7
        invalid_target       = 8
        OTHERS               = 9.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

  ENDIF.

  COMMIT WORK AND WAIT.

ENDFORM.                    " CALL_PGM_INCASSI
