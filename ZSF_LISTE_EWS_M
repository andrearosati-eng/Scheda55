FORM riempi_mirror_dopo_chiamata  USING ls_mirror_dat TYPE zfm_mirror_dat
      ls_mirror_err TYPE zfm_mirror_err.
**************************************************************************
* DICHIARAZIONE COSTANTI                                                 *
**************************************************************************
  CONSTANTS: lc_origine      TYPE zorigine_flusso VALUE 'SAP'.
  CONSTANTS: lc_destinazione TYPE zdestinaz       VALUE 'EWS'.
  CONSTANTS: lc_flusso       TYPE zid_flusso_ws   VALUE 'I'.

**************************************************************************
* DICHIARAZIONE DATI                                                     *
**************************************************************************

  DATA: lv_message(100).
  DATA: lv_ok(1).

**************************************************************************
* TIMESTAMP RISPOSTA                                                     *
**************************************************************************
  GET TIME STAMP FIELD ls_mirror_dat-ztimest_out.
**************************************************************************
* ESITO TRASMISSIONE                                                     *
**************************************************************************

  IF gv_error IS NOT INITIAL. "si è verificato un errore durante la trasmissione
**************************************************************************
* GESTIONE ERRORE DI TRASMISSIONE                                        *
**************************************************************************

    CALL FUNCTION 'MESSAGE_TEXT_BUILD'
      EXPORTING
        msgid               = 'ZCMPO'
        msgnr               = '907'
*       MSGV1               = ' '
*       MSGV2               = ' '
*       MSGV3               = ' '
*       MSGV4               = ' '
      IMPORTING
        message_text_output = lv_message.
    ls_mirror_dat-zesito     = lv_message.
    ls_mirror_dat-zcnt_error = 1.
*************************************************************************
* POPOLAMENTO MIRROR ERR                                                *
*************************************************************************

    ls_mirror_err-zorigine     = lc_origine.
    ls_mirror_err-zdestinaz    = lc_destinazione.
    ls_mirror_err-zanno        = sy-datum(4).
    ls_mirror_err-track_number = gv_n_lista.
    ls_mirror_err-zdtmess      = sy-datum.
    ls_mirror_err-id_flusso    = lc_flusso.
    ls_mirror_err-zcnt_error   = 1.
    ls_mirror_err-message      = lv_message.
    ls_mirror_err-testo_libero = gv_error.
    ls_mirror_err-type         = 'E'.
    GET TIME STAMP FIELD ls_mirror_err-ztmmess.
    INSERT zfm_mirror_err FROM ls_mirror_err.
    IF sy-subrc <> 0.

      lv_ok = 'X'.

    ENDIF.
  ELSE.
**************************************************************************
* TRASMISSIONE CORRETTA                                                  *
**************************************************************************

    CALL FUNCTION 'MESSAGE_TEXT_BUILD'
      EXPORTING
        msgid               = 'ZCMPO'
        msgnr               = '906'
*       MSGV1               = ' '
*       MSGV2               = ' '
*       MSGV3               = ' '
*       MSGV4               = ' '
      IMPORTING
        message_text_output = lv_message.
    ls_mirror_dat-zesito = lv_message.


  ENDIF.
**************************************************************************
* INSERIMENTO IN DB                                                      *
**************************************************************************

  INSERT zfm_mirror_dat FROM ls_mirror_dat.
  IF sy-subrc <> 0.

    lv_ok = 'X'.

  ENDIF.
**************************************************************************
* COMMIT E ROLLBACK                                                      *
**************************************************************************

  IF lv_ok IS INITIAL.

    COMMIT WORK.

  ELSE.

    ROLLBACK WORK.

  ENDIF.
*************************************************************************

