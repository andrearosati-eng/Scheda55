* CALCOLARE LA SECONDA RIGA DI DETAIL                                 *
***********************************************************************
*          lv_tabix = sy-tabix.
*          PERFORM prepara_mel_document_detail USING lv_tabix.

*          ENDIF.
          gs_zmel_sospesi-gjahr                = gs_ord_ews-gjahr.
          gs_zmel_sospesi-blart                = gs_ord_ews-blart.
          gs_zmel_sospesi-numero_ordinativo    = gs_ord_ews-belnr+4(6).
          gs_zmel_sospesi-codice_ente          = gs_zmel_document-codice_ente.
          gs_zmel_sospesi-zsfvers              = gs_zmel_docu_detail-lifnr.
          gs_zmel_sospesi-importo_provvisorio  = gs_sospesi-imp_sosp_mndt.
          gs_zmel_sospesi-zzfs_gsa             = gs_zmel_document-zzfs_gsa.
          PERFORM converti_num_sosp USING gs_sospesi-num_sosp.
          IF gv_err IS INITIAL.
            APPEND gs_zmel_sospesi TO gt_zmel_sospesi.
          ENDIF.
          CLEAR gs_zmel_sospesi.

        ENDLOOP.
      ENDIF.

    WHEN 'R'.
************************************************************************
* ESTRAZIONE SOSPESI DA REVERSALI                                      *
************************************************************************

      SELECT * FROM zfm_sosp                         "#EC CI_SEL_NESTED
        INTO TABLE @gt_sospesi_rev            "#EC CI_ALL_FIELDS_NEEDED
        WHERE n_rev    EQ @gs_ord_ews-belnr
          AND fikrs    EQ @p_fikrs
          AND gjahr    EQ @gs_ord_ews-gjahr.

      IF sy-subrc EQ 0.

        LOOP AT gt_sospesi_rev INTO gs_sospesi_rev. "#EC CI_LOOP_INTO_WA

*          IF sy-tabix GT 1.
***********************************************************************
* CALCOLARE LA SECONDA RIGA DI DETAIL                                 *
***********************************************************************
*            lv_tabix = sy-tabix.
*            PERFORM prepara_mel_document_detail USING lv_tabix.

*          ENDIF.

          gs_zmel_sospesi-gjahr                = gs_ord_ews-gjahr.
          gs_zmel_sospesi-blart                = gs_ord_ews-blart.
          gs_zmel_sospesi-numero_ordinativo    = gs_ord_ews-belnr+4(6).
          gs_zmel_sospesi-codice_ente          = gs_zmel_document-codice_ente.
          gs_zmel_sospesi-zsfvers              = gs_zmel_docu_detail-lifnr.
          gs_zmel_sospesi-importo_provvisorio  = gs_sospesi_rev-imp_sosp_rev.
          gs_zmel_sospesi-zzfs_gsa             = gs_zmel_document-zzfs_gsa.
          PERFORM converti_num_sosp USING gs_sospesi_rev-num_sosp.

          IF gv_err IS INITIAL.
            APPEND gs_zmel_sospesi TO gt_zmel_sospesi.
          ENDIF.
          CLEAR  gs_sospesi_rev.

        ENDLOOP.

      ENDIF.
  ENDCASE.



ENDFORM.                    " PREPARA_MEL_SOSPESI
