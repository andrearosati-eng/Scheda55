* CONTROLLO SU CAPITOLO                             *
*****************************************************
*il capitolo non può essere più lungo di 6 caratteri
      lv_fipex = gs_zfm_rev_t-fipex.
      lv_fipex_length = strlen( lv_fipex ).             "#EC CI_CONV_OK

      IF lv_fipex_length GT 6.
*        gv_err = 'X'.     modifica per eupolis
      ENDIF.

******************************************************
      IF gv_err IS INITIAL.  "solo se supera il controllo che non sia presente in zmel_docuemnt
        APPEND gs_alv_out TO gt_alv_out.
      ENDIF.

      CLEAR : gs_zfm_rev_t,gs_alv_out,gs_zfm_liq_rev,gs_zfm_liq_t,gs_zfm_liq_r,gs_lfa1,gv_err,
     gs_zfm_liq_t, gs_zfm_liq_r,gs_alv_out.

    ENDSELECT.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA
  ENDIF.
***********************************************************************
***********************************************************************

  SORT gt_alv_out BY tipo_doc mand_rev gjahr.

ENDFORM.                    " ESTRAI_DATI
