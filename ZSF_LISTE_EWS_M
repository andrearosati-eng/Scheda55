FORM inserisci_dettaglio  USING    lv_stato_lista TYPE char2
                                   ls_document    TYPE zmel_document.

  DATA: ls_listedet       TYPE zfm_listedet_ews.
  DATA: ls_document_check TYPE zmel_document.

  ls_listedet-bukrs          = p_fikrs.
  ls_listedet-codice_ente    = ls_document-codice_ente.
  ls_listedet-gjahr          = ls_document-gjahr.
  ls_listedet-zsfnlista      = gv_n_lista.
  ls_listedet-zsfprg         = ls_document-numero_ordinativo.
  ls_listedet-blart          = ls_document-blart.
  ls_listedet-dt_creazione   = sy-datum.
  ls_listedet-ora_creazione  = sy-timlo.
  ls_listedet-user_creazione = sy-uname.

* valorizazzione tipo operazione

  SELECT SINGLE * FROM zmel_document                 "#EC CI_SEL_NESTED
    INTO  @ls_document_check                  "#EC CI_ALL_FIELDS_NEEDED
    WHERE blart       EQ @ls_document-blart
    AND   belnr       EQ @ls_document-belnr
    AND   gjahr       EQ @ls_document-gjahr
    AND   codice_ente EQ @ls_document-codice_ente.

  IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

  CASE ls_document-blart.
    WHEN 'M'.
      CASE ls_document-dcm_operation.
        WHEN 'NEW'.
          "inserimento
          ls_listedet-zsftplista = 'M'.
        WHEN 'OVERWRITE'.
* è una variazione
          ls_listedet-zsftplista = '1'.
* annullo
        WHEN 'DELETE'.
* è una cancellazione
          ls_listedet-zsftplista = '5'.
      ENDCASE.
    WHEN 'R'.
      CASE ls_document-dcm_operation.
        WHEN 'NEW'.
          "inserimento
          ls_listedet-zsftplista = 'R'.
        WHEN 'OVERWRITE'.
* è una variazione
          ls_listedet-zsftplista = '2'.
* annullo
        WHEN 'DELETE'.
* è una cancellazione
          ls_listedet-zsftplista = '6'.
      ENDCASE.
  ENDCASE.

  MODIFY zfm_listedet_ews FROM ls_listedet.         "#EC CI_IMUD_NESTED


