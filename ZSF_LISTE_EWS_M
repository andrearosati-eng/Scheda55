*end delete FP290416


**start  insert FP290416
    IF sy-subrc EQ 0.

      CLEAR: v_data_firma, v_stato.
      IF ls_zmel_document-blart = 'M'.
*        SELECT SINGLE stato, data_firma FROM zfm_liq_t "#EC CI_SEL_NESTED
        SELECT SINGLE stato, data_firma, stato_mand FROM zfm_mand_t INNER JOIN zfm_mand_r "#EC CI_SEL_NESTED
