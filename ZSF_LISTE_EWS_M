*   INS EB300317 WP13 ID 115
*----------------------------------------------------------------------*
FORM check_reversale_sostituita .

  " reversale sostituita
  DATA: s_rev_sost   TYPE zfm_rev_t,
        s_rev_r_sost TYPE zfm_rev_r,

        " variabili d'appoggio per controllo cliente
        v_kunnr_new  TYPE bseg-kunnr,
        v_kunnr_sost TYPE bseg-kunnr,
        v_subrc      TYPE sy-subrc.

  " controllo che sia a sostituzione di una reversale
  CHECK gs_zfm_rev_t-nr_reversale_sost   IS NOT INITIAL
  AND   gs_zfm_rev_t-anno_reversale_sost IS NOT INITIAL.

***********************************************************
*La reversale sostituita deve essere annullata            *
***********************************************************

  SELECT SINGLE * FROM zfm_rev_t              "#EC CI_ALL_FIELDS_NEEDED
    INTO @s_rev_sost                                 "#EC CI_SEL_NESTED
    WHERE fikrs EQ @p_fikrs
    AND   gjahr EQ @gs_zfm_rev_t-anno_reversale_sost
    AND   n_rev EQ @gs_zfm_rev_t-nr_reversale_sost
    AND   stato EQ 'A'
    .
  IF sy-subrc <> 0.

    gv_err = abap_true.

    PERFORM gestisci_errore USING TEXT-028
                                  gc_icon_e.

    RETURN.

  ENDIF.

***********************************************************
*La reversale sostituita deve essere quietanziata         *
***********************************************************

  SELECT SINGLE * FROM zfm_rev_r              "#EC CI_ALL_FIELDS_NEEDED
    INTO @s_rev_r_sost                               "#EC CI_SEL_NESTED
    WHERE fikrs     EQ @p_fikrs
    AND   gjahr     EQ @s_rev_sost-gjahr
    AND   n_pre_rev EQ @s_rev_sost-n_pre_rev.

  IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

  IF  s_rev_r_sost-numero_quietanza IS INITIAL
  OR  s_rev_r_sost-data_quietanza   IS INITIAL
  OR  s_rev_r_sost-importo_r NE s_rev_r_sost-imp_quiet.

    gv_err = abap_true.

    PERFORM gestisci_errore USING TEXT-029
                                  gc_icon_e.

    RETURN.

  ENDIF.

***********************************************************
*  La reversale sostituente e la sostituita devono far    *
* riferimento allo stesso esercizio                       *
***********************************************************

  IF gs_zfm_rev_t-gjahr NE s_rev_sost-gjahr.

    gv_err = abap_true.

    PERFORM gestisci_errore USING TEXT-030
                                  gc_icon_e.

    RETURN.

  ENDIF.

***********************************************************
*  Le anagrafiche del cliente della reversale sostituente *
*  e della sostituita devono coincidere                   *
***********************************************************

  IF gs_zfm_rev_t-num_doc_mm IS INITIAL.
    " reversale new
    PERFORM ottieni_creditore
                USING
                   gs_zfm_rev_t-num_doc_fi
                   gs_zfm_rev_t-aa_doc_fi
                   v_kunnr_new
                   gs_zfm_rev_t-gjahr      "Ins GM130121
                   gs_zfm_rev_t-n_pre_rev  "Ins GM130121
                   gs_zfm_rev_t-stato      "Ins LS230421
                   v_subrc.
* Start ins LS310821
  ELSE.
    PERFORM ottieni_creditore USING gs_zfm_rev_t-num_doc_mm
                                    gs_zfm_rev_t-aa_doc_fi
                                    v_kunnr_new
                                    gs_zfm_rev_t-gjahr      "Ins GM130121
                                    gs_zfm_rev_t-n_pre_rev  "Ins GM130121
                                    gs_zfm_rev_t-stato      "Ins LS230421
                                    v_subrc. "ins eb0707
  ENDIF.
* End   ins LS310821

  IF v_subrc <> 0.

    gv_err = abap_true.

    PERFORM gestisci_errore USING TEXT-016
                                  gc_icon_e.

    RETURN.

  ENDIF.

  " reversale sostituita

  IF s_rev_sost-num_doc_mm IS INITIAL.
    PERFORM ottieni_creditore
                USING
                   s_rev_sost-num_doc_fi
                   s_rev_sost-aa_doc_fi
                   v_kunnr_sost
                   s_rev_sost-gjahr      "Ins GM130121
                   s_rev_sost-n_pre_rev  "Ins GM130121
                   s_rev_sost-stato      "Ins LS230421
                   v_subrc.
* Start ins LS310821
  ELSE.
    PERFORM ottieni_creditore USING s_rev_sost-num_doc_mm
                                    s_rev_sost-aa_doc_fi
                                    v_kunnr_sost
                                    s_rev_sost-gjahr      "Ins GM130121
                                    s_rev_sost-n_pre_rev  "Ins GM130121
                                    s_rev_sost-stato      "Ins LS230421
                                    v_subrc. "ins eb0707
  ENDIF.
* End   ins LS310821

  IF v_subrc <> 0.

    gv_err = abap_true.

    PERFORM gestisci_errore USING TEXT-016
                                  gc_icon_e.

    RETURN.

  ENDIF.

  IF v_kunnr_new NE v_kunnr_sost.

    gv_err = abap_true.

    PERFORM gestisci_errore USING TEXT-031
                                  gc_icon_e.

    RETURN.

  ENDIF.

***********************************************************
* Gli importi delle reversali devono coincidere           *
***********************************************************

****  IF gs_zfm_rev_t-imp_rev NE s_rev_sost-imp_rev.
