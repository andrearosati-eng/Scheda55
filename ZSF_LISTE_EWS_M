*****************************************************
* ESTRAZIONE MANDATI                                *
*****************************************************
  IF p_mand IS NOT INITIAL. "estrarre i dati solo se sono stati selezionati dall'utente
    SELECT * FROM zfm_liq_t                   "#EC CI_ALL_FIELDS_NEEDED
      INTO gs_zfm_liq_t
      WHERE fikrs          EQ p_fikrs "estrae i dati secondo le scelte dell'utente dalla testata
        AND   anno_mandato IN s_aa_liq
        AND   nr_mandato   IN s_n_liq
        AND   nr_mandato   NE space       " ins EB070417
        AND   dt_mandato   IN s_dt_liq
"       AND   stato        EQ 'D'       "delete FP290416
*       AND   zsfstlista   NE 'LF'.
        AND   stato        IN r_stato      "insert FP290416
        AND   usnam_ins    IN s_uname      "Ins GM300620
        AND   zsfstlista   NOT IN r_stato_lista.

      gs_alv_out-mand_rev =  gs_zfm_liq_t-nr_mandato.
      gs_alv_out-tipo_doc =  gc_mandato.
      WRITE gs_zfm_liq_t-dt_mandato TO gs_alv_out-data_reg.
      gs_alv_out-importo  =  gs_zfm_liq_t-imp_liq.
      gs_alv_out-gjahr    =  gs_zfm_liq_t-anno_mandato.
      gs_alv_out-n_liq    =  gs_zfm_liq_t-n_liq.
*      gs_alv_out-divisa_importo = 'EUR'. "fisso a euro
      gs_alv_out-note_liq = gs_zfm_liq_t-note_mndt.

