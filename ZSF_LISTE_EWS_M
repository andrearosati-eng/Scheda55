*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM estrai_dati_da_spedire.

************************************************************************
*in questa fase preparo i dati da spedire                              *
************************************************************************

  REFRESH: gt_zmel_document, gt_zmel_docu_detail,gt_zmel_revcoll,gt_zmel_capitoli.
  PERFORM valorizza_costanti_bollo.
  PERFORM valorizza_costanti_pagamenti. "ins eb290616
  LOOP AT gt_ord_ews INTO gs_ord_ews.
************************************************************************
*PULIZIA DELLE WA                                                      *
************************************************************************
    CLEAR: gs_zmel_document,gs_zmel_docu_detail,gs_zmel_revcoll,gs_zmel_capitoli.
    CLEAR: gv_err,gv_war.
************************************************************************
* POPOLAMENTO TABELLE PONTE                                            *
************************************************************************
    PERFORM prepara_zmel_document.
    PERFORM prepara_mel_document_detail USING 1.
    IF gv_err IS INITIAL.
      PERFORM prepara_mel_capitoli.

      IF gs_ord_ews-blart EQ 'M'.
        PERFORM prepara_mel_revcoll.
      ENDIF.

      PERFORM prepara_mel_sospesi.

* START INS EB130617 WP13 ID 245
*      IF gv_mod_invio EQ gc_opi.
*        PERFORM prepara_mel_fatture.
*      ENDIF.
* END   INS EB130617 WP13 ID 245

    ENDIF.

  ENDLOOP.


*routine fuori da loop precedente per poter leggere tabelle interne
*zmel_document e zmel_docu_detail
  IF gv_mod_invio EQ gc_opi .
    LOOP  AT gt_ord_ews INTO gs_ord_ews.           "#EC CI_LOOP_INTO_WA
      PERFORM prepara_mel_fatture.
    ENDLOOP.
  ENDIF.


************************************************************************
* CHECK ORDINATIVI ERRATI                                              *
************************************************************************
  PERFORM check_ordinativi_errati.
************************************************************************
* CHECK ORDINATIVI GIA INVIATI                                         *
************************************************************************

  PERFORM set_to_import.

************************************************************************
* SCRITTURA E TRASMISSIONE ORDINATIVI                                  *
************************************************************************
  CLEAR: gs_zmel_document,gs_zmel_docu_detail,gs_zmel_revcoll,gs_zmel_capitoli.
  IF p_scrivi IS NOT INITIAL. "scrivi i dati su db
    PERFORM crea_liste_db.
  ENDIF.

  IF p_trasme IS NOT INITIAL AND gt_zmel_document[] IS NOT INITIAL. "trasmetti ordinativi
    PERFORM trasmetti.
  ELSEIF p_trasme IS NOT INITIAL AND gt_zmel_document IS INITIAL
  AND gt_zmel_document_err IS NOT INITIAL.
    IF sy-calld NE 'X'.    "IDC
      CALL SCREEN 1120.
    ELSE.
      MOVE 'KO' TO esito.
      EXPORT esito TO MEMORY ID 'ESITO'.
      READ TABLE gt_zmel_document_err ASSIGNING FIELD-SYMBOL(<err>) INDEX 1.
      IF sy-subrc EQ 0.
        MOVE <err>-errore TO descesito.
      ENDIF.
      EXPORT descesito TO MEMORY ID 'DESCESITO'.

    ENDIF.                 "IDC
  ENDIF.





ENDFORM.                    " ESTRAI_DATI_DA_SPEDIRE

*&---------------------------------------------------------------------*
*&      Form  PREPARA_MEL_CAPITOLI
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM prepara_mel_capitoli .

  CONSTANTS c_c(10) VALUE 'Competenza'.
  CONSTANTS c_r(10) VALUE 'Residuo'.
  DATA v_bldat TYPE bldat.
  DATA : lv_impegno   TYPE belnr_d.
  DATA : ls_associata TYPE zordinativi.
  DATA : lt_associata TYPE z_t_ordinativi.
  DATA : ls_kblp      TYPE kblp.
  DATA : ls_fmci      TYPE fmci.
  DATA : lv_bldat     TYPE bldat.

*-- LM122025 - MEV 117
  DATA lt_zfm_liq_r TYPE TABLE OF zfm_liq_r.
  DATA ls_imp_ews   TYPE char22.
  DATA ls_zimp_liq  TYPE zimp_liq.

*--

********************************************************************
* CAMPI COMUNI                                                     *
********************************************************************
  gs_zmel_capitoli-codice_ente     = gs_zmel_document-codice_ente.
  gs_zmel_capitoli-gjahr           =  gs_ord_ews-gjahr.
  gs_zmel_capitoli-blart           =  gs_ord_ews-blart.
  gs_zmel_capitoli-belnr           =  gs_zmel_document-numero_ordinativo.
  gs_zmel_capitoli-importo_bilancio = gs_zmel_document-wtjhr.
  gs_zmel_capitoli-zzfs_gsa         = gs_zmel_document-zzfs_gsa.
  gs_zmel_capitoli-rl_utente        = gs_zmel_document-usnam.
  gs_zmel_capitoli-rl_data          = gs_zmel_document-rl_data.
  gs_zmel_capitoli-numero_articolo  = '0'.

*verifico se la reversale è associata ad un mandato

  IF gs_ord_ews-blart EQ 'R'.

    CALL FUNCTION 'Z_GET_ORDINATIVI_ASSOCIATI'
      EXPORTING
        numero_ordinativo    = gs_ord_ews-belnr
        tipo_ordinativo      = 'R'
        esercizio            = gs_ord_ews-gjahr
      IMPORTING
        ordinativi_associati = lt_associata
*       N_ORD_ASSOCIATI      =
      .
    IF lt_associata IS NOT INITIAL.

      READ TABLE lt_associata INTO ls_associata INDEX 1.

    ENDIF.

  ENDIF.

  IF gs_ord_ews-blart EQ 'M'. "mandato
****************************************************************************
* MANDATI                                                                  *
****************************************************************************
    CLEAR: gs_zfm_liq_t,gs_zfm_liq_r,gs_zfm_rev_t.
    SELECT SINGLE * FROM zfm_liq_t            "#EC CI_ALL_FIELDS_NEEDED
      INTO @gs_zfm_liq_t                             "#EC CI_SEL_NESTED
    WHERE fikrs        EQ @p_fikrs
    AND   anno_mandato EQ @gs_ord_ews-gjahr
    AND   nr_mandato   EQ @gs_ord_ews-belnr.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

*-- LM122025 - MEV 117
    REFRESH lt_zfm_liq_r.

    SELECT * FROM zfm_liq_r
      INTO TABLE  @lt_zfm_liq_r
      WHERE fikrs          EQ @p_fikrs
        AND n_liq          EQ @gs_zfm_liq_t-n_liq
        AND aa_liq         EQ @gs_zfm_liq_t-aa_liq
        AND riga_annullata NE 'X'.

*    SELECT SINGLE * FROM zfm_liq_r                   "#EC CI_SEL_NESTED
*      INTO @gs_zfm_liq_r                      "#EC CI_ALL_FIELDS_NEEDED
*      WHERE fikrs      EQ @p_fikrs
*      AND   aa_liq     EQ @gs_zfm_liq_t-aa_liq
*      AND   n_liq      EQ @gs_zfm_liq_t-n_liq
*      AND   n_riga_liq EQ 1.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA
*-- LM122025 - MEV 117
    LOOP AT lt_zfm_liq_r  INTO gs_zfm_liq_r.
*--
      SELECT SINGLE * FROM fmci                      "#EC CI_SEL_NESTED
        INTO @ls_fmci                         "#EC CI_ALL_FIELDS_NEEDED
         WHERE fikrs  EQ @p_fikrs
         AND   gjahr  EQ @gs_ord_ews-gjahr
         AND   fipex  EQ @gs_zfm_liq_r-fipex.

      IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA
*start pf (vedi mail Trasmissione EWS - Mandati emessi su Posizione 2 (anno 2017))

*    SELECT SINGLE bldat FROM kblk INTO lv_bldat WHERE belnr EQ gs_zfm_liq_r-impegno.
      SELECT SINGLE fdatk FROM kblp                  "#EC CI_SEL_NESTED
        INTO @lv_bldat WHERE belnr EQ @gs_zfm_liq_r-impegno
         AND   blpos EQ @gs_zfm_liq_r-riga_imp.
* end   pf (vedi mail Trasmissione EWS - Mandati emessi su Posizione 2 (anno 2017))

      IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

      gs_zmel_capitoli-lifnr = '0'.
      CONCATENATE ls_fmci-zzsf_missioni(2) ls_fmci-zzsf_programmi(2) ls_fmci-zz_titolo(1) INTO gs_zmel_capitoli-codifica_bilancio SEPARATED BY ''.
      CONDENSE  gs_zmel_capitoli-codifica_bilancio NO-GAPS.

      IF gs_ord_ews-gjahr > lv_bldat(4) AND lv_bldat NE '0000'. "se l'anno del documento è maggiore di quella dell'impegno

        gs_zmel_capitoli-gestione = 'RESIDUO'.
        gs_zmel_capitoli-anno_residuo = lv_bldat(4).
      ELSE.
        gs_zmel_capitoli-gestione = 'COMPETENZA'.

      ENDIF.

*-- LM122025 - MEV 117
      ls_zimp_liq     = gs_zfm_liq_r-importo_r.
      CALL FUNCTION 'Z_CONVERT_AMOUNT_EWS'
        EXPORTING
          importo_sap = ls_zimp_liq
        IMPORTING
          importo_ews = ls_imp_ews.

      gs_zmel_capitoli-importo_bilancio   = ls_imp_ews.

      LOOP AT gt_zmel_capitoli ASSIGNING FIELD-SYMBOL(<f_cap>)
              WHERE gjahr             = gs_zmel_capitoli-gjahr
                AND blart             = gs_zmel_capitoli-blart
                AND belnr             = gs_zmel_capitoli-belnr
                AND codice_ente       = gs_zmel_capitoli-codice_ente
                AND lifnr             = gs_zmel_capitoli-lifnr
                AND codifica_bilancio = gs_zmel_capitoli-codifica_bilancio.
        EXIT.
      ENDLOOP.
      IF sy-subrc IS INITIAL.
        <f_cap>-importo_bilancio =
        <f_cap>-importo_bilancio + gs_zmel_capitoli-importo_bilancio.

        ls_zimp_liq     = <f_cap>-importo_bilancio.
        CALL FUNCTION 'Z_CONVERT_AMOUNT_EWS'
          EXPORTING
            importo_sap = ls_zimp_liq
          IMPORTING
            importo_ews = ls_imp_ews.

        <f_cap>-importo_bilancio = ls_imp_ews.

      ELSE.
        COLLECT gs_zmel_capitoli INTO gt_zmel_capitoli.
      ENDIF.
    ENDLOOP.
*--
  ELSEIF gs_ord_ews-blart EQ 'R' AND lt_associata IS NOT INITIAL.
****************************************************************************
* REVERSALI CON MANDATO                                                    *
****************************************************************************
    SELECT SINGLE * FROM zfm_rev_t                   "#EC CI_SEL_NESTED
    INTO @gs_zfm_rev_t                        "#EC CI_ALL_FIELDS_NEEDED
      WHERE fikrs EQ @p_fikrs
    AND   gjahr EQ @gs_ord_ews-gjahr
    AND   n_rev EQ @gs_ord_ews-belnr.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    SELECT SINGLE * FROM zfm_liq_t                   "#EC CI_SEL_NESTED
      INTO @gs_zfm_liq_t                      "#EC CI_ALL_FIELDS_NEEDED
      WHERE fikrs        EQ @p_fikrs
    AND   anno_mandato EQ @ls_associata-aa_ord
    AND   nr_mandato   EQ @ls_associata-n_ord.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    SELECT SINGLE * FROM zfm_liq_r                   "#EC CI_SEL_NESTED
      INTO @gs_zfm_liq_r                      "#EC CI_ALL_FIELDS_NEEDED
      WHERE fikrs      EQ @p_fikrs
    AND   aa_liq     EQ @gs_zfm_liq_t-aa_liq
    AND   n_liq      EQ @gs_zfm_liq_t-n_liq
    AND   n_riga_liq EQ 1.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    SELECT SINGLE * FROM fmci                 "#EC CI_ALL_FIELDS_NEEDED
      INTO @ls_fmci                                  "#EC CI_SEL_NESTED
      WHERE fikrs  EQ @p_fikrs
    AND   gjahr  EQ @gs_ord_ews-gjahr
    AND   fipex  EQ @gs_zfm_rev_t-fipex.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    SELECT SINGLE fdatk FROM kblp INTO @lv_bldat     "#EC CI_SEL_NESTED
      WHERE belnr EQ @gs_zfm_rev_t-n_accert
    AND   blpos EQ @gs_zfm_rev_t-pos_accert.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    gs_zmel_capitoli-lifnr = '0'.
    CONCATENATE ls_fmci-zz_titolo(1) ls_fmci-zztipologia(4) INTO gs_zmel_capitoli-codifica_bilancio.
    IF gs_ord_ews-gjahr > lv_bldat(4) AND lv_bldat NE '0000'. "se l'anno del documento è maggiore di quella dell'impegno

      gs_zmel_capitoli-gestione = 'RESIDUO'.
      gs_zmel_capitoli-anno_residuo = lv_bldat(4).
    ELSE.
      gs_zmel_capitoli-gestione = 'COMPETENZA'.

    ENDIF.
  ELSEIF  gs_ord_ews-blart EQ 'R' AND lt_associata IS INITIAL. "reversale singola
***************************************************************************
* REVERSALI                                                               *
***************************************************************************
    SELECT SINGLE * FROM zfm_rev_t                   "#EC CI_SEL_NESTED
      INTO @gs_zfm_rev_t                      "#EC CI_ALL_FIELDS_NEEDED
      WHERE  fikrs EQ @p_fikrs
        AND  gjahr EQ @gs_ord_ews-gjahr
        AND  n_rev EQ @gs_ord_ews-belnr.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    SELECT SINGLE * FROM kblp                        "#EC CI_SEL_NESTED
      INTO @ls_kblp                           "#EC CI_ALL_FIELDS_NEEDED
      WHERE belnr EQ @gs_zfm_rev_t-n_accert
        AND blpos EQ @gs_zfm_rev_t-pos_accert.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    SELECT SINGLE * FROM fmci                        "#EC CI_SEL_NESTED
      INTO @ls_fmci                           "#EC CI_ALL_FIELDS_NEEDED
      WHERE fikrs  EQ @p_fikrs
    AND   gjahr  EQ @gs_ord_ews-gjahr
    AND   fipex  EQ @gs_zfm_rev_t-fipex.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    SELECT SINGLE fdatk FROM kblp                    "#EC CI_SEL_NESTED
      INTO @lv_bldat WHERE belnr EQ @gs_zfm_rev_t-n_accert
    AND   blpos EQ @gs_zfm_rev_t-pos_accert.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    IF gs_zfm_rev_t-num_doc_mm IS INITIAL.
* ESTRAZIONE CLIENTE 09/03/2016
      PERFORM ottieni_creditore USING gs_zfm_rev_t-num_doc_fi
            gs_zfm_rev_t-aa_doc_fi
            ls_kblp-kunnr
            gs_zfm_rev_t-gjahr      "Ins GM130121
            gs_zfm_rev_t-n_pre_rev  "Ins GM130121
            gs_zfm_rev_t-stato      "Ins LS230421
            gv_subrc. "ins eb070716
* Start ins LS310821
    ELSE.
      PERFORM ottieni_creditore USING gs_zfm_rev_t-num_doc_mm
                                      gs_zfm_rev_t-aa_doc_fi
                                      ls_kblp-kunnr
                                      gs_zfm_rev_t-gjahr      "Ins GM130121
                                      gs_zfm_rev_t-n_pre_rev  "Ins GM130121
                                      gs_zfm_rev_t-stato      "Ins LS230421
                                      gv_subrc. "ins eb0707
    ENDIF.
* End   ins LS310821

*    gs_zmel_docu_detail-lifnr = ls_kblp-kunnr+4(6).
    gs_zmel_capitoli-lifnr = '0'.
    CONCATENATE ls_fmci-zz_titolo(1) ls_fmci-zztipologia(4) INTO gs_zmel_capitoli-codifica_bilancio.
    IF gs_ord_ews-gjahr > lv_bldat(4) AND lv_bldat NE '0000'. "se l'anno del documento è maggiore di quella dell'impegno

      gs_zmel_capitoli-gestione = 'RESIDUO'.
      gs_zmel_capitoli-anno_residuo = lv_bldat(4).
    ELSE.
      gs_zmel_capitoli-gestione = 'COMPETENZA'.

    ENDIF.
  ENDIF.
*********************************************************************************
*********************************************************************************
*-- LM122025 - MEV 117
  IF gs_ord_ews-blart NE 'M'. "mandato
*--
    IF gv_err IS INITIAL.
      APPEND gs_zmel_capitoli TO gt_zmel_capitoli.
    ENDIF.
  ENDIF.

ENDFORM.                    " PREPARA_MEL_CAPITOLI
*&---------------------------------------------------------------------*
*&      Form  PREPARA_MEL_REVCOLL
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM prepara_mel_revcoll.

  DATA: lt_associata TYPE z_t_ordinativi,
        ls_associata TYPE zordinativi.
  DATA: ls_rev_t TYPE zfm_rev_t,
        ls_kblp  TYPE kblp.
  DATA: ls_liq_t      TYPE zfm_liq_t.
  DATA: ls_liq_r      TYPE zfm_liq_r.
  DATA  ls_liq_rev    TYPE zfm_liq_rev.

  DATA: "ls_abbuoni_par TYPE zfm_abbuoni_par,
    ls_bkpf TYPE bkpf,
    lv_abp  TYPE xfeld.

************************************************************************
* DATI DI TESTATA                                                      *
************************************************************************
  gs_zmel_revcoll-gjahr = gs_ord_ews-gjahr.
  gs_zmel_revcoll-blart = gs_ord_ews-blart.
  gs_zmel_revcoll-numero_ordinativo = gs_zmel_document-numero_ordinativo.
************************************************************************
* PRENDERE ORDINATIVI ASSOCIATI                                        *
************************************************************************
  CALL FUNCTION 'Z_GET_ORDINATIVI_ASSOCIATI'
    EXPORTING
      numero_ordinativo    = gs_ord_ews-belnr
      tipo_ordinativo      = 'M'
      esercizio            = gs_ord_ews-gjahr
    IMPORTING
      ordinativi_associati = lt_associata
*     N_ORD_ASSOCIATI      =
    .

  LOOP AT lt_associata INTO ls_associata.

    gs_zmel_revcoll-belnp = ls_associata-n_ord+4(6).

*    SELECT SINGLE * FROM zfm_liq_t
*      INTO @ls_liq_t
*      WHERE nr_mandato   EQ @gs_ord_ews-belnr
*        AND anno_mandato EQ @gs_ord_ews-gjahr.

    SELECT * FROM zfm_liq_t    UP TO 1 ROWS          "#EC CI_SEL_NESTED
         INTO @ls_liq_t                       "#EC CI_ALL_FIELDS_NEEDED
      WHERE nr_mandato   EQ @gs_ord_ews-belnr
        AND anno_mandato EQ @gs_ord_ews-gjahr
            ORDER BY PRIMARY KEY   .
    ENDSELECT.



    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

*Start ins GM260421
    "Se il mandato è split ha delle reversali collegate
    "Ma non sono spedite come reversali vincolate in quanto non si tratta di ritenute
    IF ls_liq_t-mandato_split EQ 'X'.
      CONTINUE.
    ENDIF.
*End   ins GM260421


*Start ins GM071221 - Mandato da abbuono passivo vale come split
    "Controllo se su abbuono
    CLEAR lv_abp.
*    SELECT SINGLE  * FROM  zfm_abbuoni_par
*           INTO CORRESPONDING FIELDS OF ls_abbuoni_par
*           WHERE  tipo_abbuono EQ 'P'.
*    IF sy-subrc IS INITIAL.
*      SELECT        * FROM  zfm_liq_r
*             INTO CORRESPONDING FIELDS OF ls_liq_r
*             WHERE  fikrs   EQ ls_liq_t-fikrs
*             AND    aa_liq  EQ ls_liq_t-aa_liq
*             AND    n_liq   EQ ls_liq_t-n_liq.
*        SELECT SINGLE * FROM  bkpf
*               INTO CORRESPONDING FIELDS OF ls_bkpf
*               WHERE  bukrs  EQ ls_liq_r-fikrs
*               AND    belnr  EQ ls_liq_r-num_doc_fi
*               AND    gjahr  EQ ls_liq_r-aa_doc_fi.
*        IF sy-subrc IS INITIAL.
*          IF ls_bkpf-blart EQ ls_abbuoni_par-blart.
*            lv_abp = 'X'.
*          ENDIF.
*        ENDIF.
*      ENDSELECT.
*    ENDIF.
    IF lv_abp IS NOT INITIAL.
      CONTINUE.
    ENDIF.
*End   ins GM071221

    SELECT SINGLE * FROM zfm_rev_t                   "#EC CI_SEL_NESTED
      INTO @ls_rev_t                          "#EC CI_ALL_FIELDS_NEEDED
      WHERE fikrs  EQ @p_fikrs
    AND   n_rev  EQ @ls_associata-n_ord
    AND   gjahr  EQ @ls_associata-aa_ord.
    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

*    SELECT SINGLE * FROM zfm_liq_r                   "#EC CI_SEL_NESTED
*      INTO @ls_liq_r                          "#EC CI_ALL_FIELDS_NEEDED
*       WHERE fikrs EQ @p_fikrs
*    AND   n_liq EQ @ls_liq_t-n_liq
*    AND  aa_liq EQ @ls_liq_t-aa_liq.

    SELECT   * FROM zfm_liq_r    UP TO 1 ROWS        "#EC CI_SEL_NESTED
INTO @ls_liq_r                                "#EC CI_ALL_FIELDS_NEEDED
     WHERE fikrs EQ @p_fikrs
  AND   n_liq EQ @ls_liq_t-n_liq
  AND  aa_liq EQ @ls_liq_t-aa_liq
ORDER BY PRIMARY KEY      .
    ENDSELECT.

