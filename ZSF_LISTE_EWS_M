*&      Form  alv_user_command
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ALV_UCOMM     text
*      -->ALV_SELFIELD  text
*----------------------------------------------------------------------*
FORM alv_user_command USING alv_ucomm TYPE sy-ucomm
      alv_selfield TYPE slis_selfield.
*************************************************************************
*  VARIABILI LOCALI                                                     *
*************************************************************************
  DATA : lv_aa_liq TYPE gjahr. "variabile d'appoggio locale per l'anno della liquidazione
  DATA : ref_grid TYPE REF TO cl_gui_alv_grid. "new
  DATA : ref_grid_send TYPE REF TO cl_gui_alv_grid.
  DATA : ref_cells TYPE lvc_t_cell.
  DATA : gt_bdcdata TYPE TABLE OF bdcdata.
  DATA : gs_bdcdata TYPE bdcdata.
  DATA: ls_params TYPE ctu_params. "ins EB140616
  DATA : ls_kblk  TYPE kblk. "ins EB010816
  alv_selfield-refresh = 'X'.
  ls_params-nobinpt = 'X'. "ins EB140616
  ls_params-dismode = 'E'. "ins EB140616
*************************************************************************
  CASE alv_ucomm.

    WHEN '&IC1'.
*************************************************************************
* GESTIONE HOTSPOT                                                      *
*************************************************************************
      CASE alv_selfield-fieldname.
        WHEN 'MAND_REV'.

          READ TABLE gt_alv_out INTO gs_alv_out INDEX alv_selfield-tabindex.
          IF gs_alv_out-tipo_doc(1) EQ 'M'.

            gs_bdcdata-program  = 'ZFM_GESTIONE_MANDATI'.
            gs_bdcdata-dynpro   = '1000'.
            gs_bdcdata-dynbegin = 'X'.
            APPEND gs_bdcdata TO gt_bdcdata.
            CLEAR  gs_bdcdata.

            gs_bdcdata-fnam     = 'BDC_OKCODE'.
            gs_bdcdata-fval     = '=UCOMM'.
            APPEND gs_bdcdata TO gt_bdcdata.
            CLEAR  gs_bdcdata.


            gs_bdcdata-fnam     = 'RB_V'.
            gs_bdcdata-fval     = 'X'.
            APPEND gs_bdcdata TO gt_bdcdata.
            CLEAR  gs_bdcdata.

            gs_bdcdata-program  = 'ZFM_GESTIONE_MANDATI'.
            gs_bdcdata-dynpro   = '1000'.
            gs_bdcdata-dynbegin = 'X'.
            APPEND gs_bdcdata TO gt_bdcdata.
            CLEAR  gs_bdcdata.

            gs_bdcdata-fnam     = 'BDC_OKCODE'.
            gs_bdcdata-fval     = '=ONLI'.
            APPEND gs_bdcdata TO gt_bdcdata.
            CLEAR  gs_bdcdata.

            gs_bdcdata-fnam     = 'S_MNDT-LOW'.
            gs_bdcdata-fval     = alv_selfield-value.
            APPEND gs_bdcdata TO gt_bdcdata.
            CLEAR gs_bdcdata.

            gs_bdcdata-fnam     = 'S_AA_MDT-LOW'.
            gs_bdcdata-fval     = gs_alv_out-gjahr.
            APPEND gs_bdcdata TO gt_bdcdata.
            CLEAR  gs_bdcdata.


            gs_bdcdata-program  = 'SAPMSSY0'.
            gs_bdcdata-dynpro   = '0120'.
            gs_bdcdata-dynbegin = 'X'.
            APPEND gs_bdcdata TO gt_bdcdata.
            CLEAR  gs_bdcdata.


            gs_bdcdata-fnam     = 'BDC_CURSOR'.
            gs_bdcdata-fval     = '06/57'.
            APPEND gs_bdcdata TO gt_bdcdata.
            CLEAR  gs_bdcdata.


            gs_bdcdata-fnam     = 'BDC_OKCODE'.
            gs_bdcdata-fval     = '=&IC1'.
            APPEND gs_bdcdata TO gt_bdcdata.
            CLEAR  gs_bdcdata.


            CALL TRANSACTION 'ZFM_GESTIONE_MANDATI' USING gt_bdcdata OPTIONS FROM ls_params.



          ELSE.

            READ TABLE gt_alv_out INTO gs_alv_out INDEX alv_selfield-tabindex.
            REFRESH gt_bdcdata.
            CLEAR   gs_bdcdata.
            gs_bdcdata-program  = 'ZFM_GESTIONE_REVERSALI'.
            gs_bdcdata-dynpro   = '1200'.
            gs_bdcdata-dynbegin = 'X'.
            APPEND gs_bdcdata TO gt_bdcdata.

            CLEAR gs_bdcdata.
            gs_bdcdata-fnam = 'P_GJAHR'.
            gs_bdcdata-fval = gs_alv_out-gjahr.
            APPEND gs_bdcdata TO gt_bdcdata.

            CLEAR gs_bdcdata.
            gs_bdcdata-fnam = 'S_N_REV-LOW'.
            gs_bdcdata-fval = alv_selfield-value.
            APPEND gs_bdcdata TO gt_bdcdata.

            gs_bdcdata-fnam = 'BDC_OKCODE'.
            gs_bdcdata-fval = '=AVVIO'.
            APPEND gs_bdcdata TO gt_bdcdata.

            CALL TRANSACTION 'ZFM_VIS_REVERSALI' USING gt_bdcdata OPTIONS FROM ls_params.

* START DEL EB140616
*
*            SET PARAMETER ID 'FIK'   FIELD p_fikrs.
*            SET PARAMETER ID 'GJR'   FIELD gs_alv_out-gjahr.
*            SET PARAMETER ID 'ZNREV' FIELD alv_selfield-value.
*            CALL TRANSACTION 'ZFM_VIS_REVERSALI' AND SKIP FIRST SCREEN.
* END DEL EB140616
          ENDIF.


        WHEN 'IMPEGNO'.

          REFRESH gt_bdcdata.
* START EB23032016

          READ TABLE gt_alv_out INTO gs_alv_out INDEX alv_selfield-tabindex.

          CASE gs_alv_out-tipo_doc.
            WHEN 'Reversale'.
              gs_bdcdata-program  = 'SAPMZSFGCAACC'.
              gs_bdcdata-dynpro   = '0100'.
              gs_bdcdata-dynbegin = 'X'.
              APPEND gs_bdcdata TO gt_bdcdata.
              CLEAR  gs_bdcdata.

              gs_bdcdata-fnam    = 'KBLD-BELNR'.
              gs_bdcdata-fval    = alv_selfield-value.
              APPEND gs_bdcdata TO gt_bdcdata.
              CLEAR  gs_bdcdata.

              gs_bdcdata-fnam    = 'BDC_OKCODE'.
              gs_bdcdata-fval    = '=VISUALIZZA'.
              APPEND gs_bdcdata TO gt_bdcdata.
              CLEAR  gs_bdcdata.

              CALL TRANSACTION 'ZSFV1' USING gt_bdcdata MODE 'E'.


            WHEN 'Mandato'.
* END   EB23032016

*START INS EB010816
* modifica alla navigabilità impegno
* per tenere in considerazione gli
*impegni da accantonamento

              SELECT SINGLE * FROM kblk
                INTO @ls_kblk                 "#EC CI_ALL_FIELDS_NEEDED
               WHERE belnr EQ @alv_selfield-value.

              IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

              CASE ls_kblk-bltyp.

                WHEN '030'.

                  gs_bdcdata-program  = 'SAPMZSXIMP'.
                  gs_bdcdata-dynpro   = '0100'.
                  gs_bdcdata-dynbegin = 'X'.
                  APPEND gs_bdcdata TO gt_bdcdata.
                  CLEAR  gs_bdcdata.

                  gs_bdcdata-fnam    = 'KBLD-BELNR'.
                  gs_bdcdata-fval    = alv_selfield-value.
                  APPEND gs_bdcdata TO gt_bdcdata.
                  CLEAR  gs_bdcdata.

                  gs_bdcdata-fnam    = 'BDC_OKCODE'.
                  gs_bdcdata-fval    = '=VISU'.
                  APPEND gs_bdcdata TO gt_bdcdata.
                  CLEAR  gs_bdcdata.

                  CALL TRANSACTION 'ZSX01' USING gt_bdcdata MODE 'E'.

                WHEN '040'.

                  gs_bdcdata-program  = 'SAPMZSXIMP'.
                  gs_bdcdata-dynpro   = '0100'.
                  gs_bdcdata-dynbegin = 'X'.
                  APPEND gs_bdcdata TO gt_bdcdata.
                  CLEAR  gs_bdcdata.

                  gs_bdcdata-fnam    = 'KBLD-BELNR'.
                  gs_bdcdata-fval    = alv_selfield-value.
                  APPEND gs_bdcdata TO gt_bdcdata.
                  CLEAR  gs_bdcdata.

                  gs_bdcdata-fnam    = 'BDC_OKCODE'.
                  gs_bdcdata-fval    = '=VISU'.
                  APPEND gs_bdcdata TO gt_bdcdata.
                  CLEAR  gs_bdcdata.

                  CALL TRANSACTION 'ZSXIG' USING gt_bdcdata MODE 'E'.
              ENDCASE.
*END INS EB010816

          ENDCASE.
      ENDCASE.

    WHEN '&INS'.
*************************************************************************
*  SELEZIONA TUTTI GLI ORDINATIVI                                       *
*************************************************************************
      LOOP AT gt_alv_out INTO gs_alv_out.

        gs_alv_out-checkbox = 'X'.
        MODIFY gt_alv_out FROM gs_alv_out.

      ENDLOOP.
    WHEN '&DES'.
*************************************************************************
*  DESELEZIONA TUTTI GLI ORDINATIVI                                     *
*************************************************************************

      LOOP AT gt_alv_out INTO gs_alv_out.

        gs_alv_out-checkbox = ' '.
        MODIFY gt_alv_out FROM gs_alv_out.

      ENDLOOP.

    WHEN '&INVIA'.
*************************************************************************
*  TRASMISSIONE ORDINATIVI                                              *
*************************************************************************

*Start del GM050521
*      IF ref_grid IS INITIAL.
*        CALL FUNCTION 'GET_GLOBALS_FROM_SLVC_FULLSCR'
*          IMPORTING
*            e_grid = ref_grid.
*      ENDIF.
*      IF NOT ref_grid IS INITIAL.
*        CALL METHOD ref_grid->check_changed_data.
*      ENDIF.
*End   del GM050521
*Start ins GM050521
      PERFORM recupera_grid.
      IF NOT go_grid IS INITIAL.
        CALL METHOD go_grid->check_changed_data.
      ENDIF.
*End   ins GM050521
      alv_selfield-refresh = 'X'.
      CLEAR: gv_err,gv_associata,gv_retcode.
      REFRESH gt_ord_ews.
      PERFORM check_associata.
      PERFORM prepara_ordinativi.

  ENDCASE.



ENDFORM.                    "alv_user_command

