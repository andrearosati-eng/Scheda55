          AND zfm_rev_t~n_pre_rev = zfm_rev_r~n_pre_rev
*            UP TO 1 ROWS                             "#EC CI_SEL_NESTED
    INTO (@v_stato, @v_data_firma, @v_opi)
  WHERE  zfm_rev_t~n_rev EQ @<wa>-belnr
      AND   zfm_rev_t~gjahr EQ @<wa>-gjahr.
*        ORDER BY PRIMARY KEY   .
*        ENDSELECT.


        IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA
