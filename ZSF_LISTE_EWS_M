* aggiungi gli ordinativi associati all'alv (avrò solo reversali)
  DATA ls_zfm_liq_t TYPE zfm_liq_t.
  DATA ls_zfm_liq_r TYPE zfm_liq_r.
  DATA ls_kna1      TYPE kna1.
  DATA ls_zfm_rev_t TYPE zfm_rev_t.
  DATA ls_associata TYPE zordinativi.
