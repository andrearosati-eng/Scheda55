*      -->P_LS_LFA1_STCD2  text
*----------------------------------------------------------------------*
FORM popola_stcd  USING    lv_stcd1
      lv_stcd2.
  DATA lv_s_stcd1 TYPE string.
  DATA lv_s_stcd2 TYPE string.
  DATA lv_length  TYPE numc2.

  lv_s_stcd1 = lv_stcd1.
  lv_s_stcd2 = lv_stcd2.

  lv_length = strlen( lv_s_stcd1 ).                     "#EC CI_CONV_OK
* controllo codice fiscale
  IF lv_length EQ 16.

    gs_zmel_docu_detail-stcd1 = lv_stcd1.
    EXIT.

  ELSEIF lv_length EQ 11.

    IF lv_stcd1(1) EQ '8' OR lv_stcd1(1) EQ '9'.

      gs_zmel_docu_detail-stcd1 = lv_stcd1.
      EXIT.

    ELSE.

      gs_zmel_docu_detail-stcd2 = lv_stcd1.
*** IM G.BER - 25/02/2016 ***
      CLEAR gs_zmel_docu_detail-stcd1.
*** FM G.BER - 25/02/2016 ***
      EXIT.

    ENDIF.

  ENDIF.


* controllo partita IVA

  lv_length = strlen( lv_s_stcd2 ).                     "#EC CI_CONV_OK

  IF lv_length EQ 11.

    IF lv_stcd2(1) EQ '8' OR lv_stcd2(1) EQ '9'.

      gs_zmel_docu_detail-stcd1 = lv_stcd2.

    ELSE.

      gs_zmel_docu_detail-stcd2 = lv_stcd2.
*** IM G.BER - 25/02/2016 ***
      CLEAR gs_zmel_docu_detail-stcd1.
*** FM G.BER - 25/02/2016 ***
    ENDIF.

  ENDIF.

ENDFORM.                    " POPOLA_STCD
