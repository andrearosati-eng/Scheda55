*&---------------------------------------------------------------------*
*&      Form  CHECK_MANDATO_SOSTITUITO
*&---------------------------------------------------------------------*
*  In questo form faccio controlli di consistenza per il mandato
*  sostituito
*  INS EB300317 WP13 ID 115
*----------------------------------------------------------------------*
*      -->P_GS_ORD_EWS  text
*      -->P_GS_ZFM_LIQ_T  text
*----------------------------------------------------------------------*
FORM check_mandato_sostituito  USING    s_ord_ews TYPE ord_ews
                                        s_liq_new TYPE zfm_liq_t.

  " per mandati sostituito/nuovo
  DATA: t_liq_r_sost TYPE TABLE OF zfm_liq_r.
  DATA: s_liq_r_new  TYPE          zfm_liq_r.
  DATA: s_liq_sost   TYPE          zfm_liq_t.
  FIELD-SYMBOLS: <r> TYPE          zfm_liq_r.

  " per reversali collegate sostituite/nuove
  DATA: t_rev_sost   TYPE TABLE OF zfm_rev_t.
  DATA: t_rev_new    TYPE TABLE OF zfm_rev_t.
  DATA: s_rev        TYPE          zfm_rev_t.
  FIELD-SYMBOLS: <rev>        TYPE zfm_rev_t.
  FIELD-SYMBOLS: <sost>       TYPE zfm_rev_t.

  " per funzione cerca ordinativi associati
  DATA: t_ordinativi TYPE          z_t_ordinativi.
  FIELD-SYMBOLS: <ord> TYPE        zordinativi.

  " variabili di appoggio
  DATA: v_subrc      TYPE          sy-subrc.
  DATA: v_kunnr_new  TYPE          kna1-kunnr.
  DATA: v_kunnr_sost TYPE          kna1-kunnr.
  DATA: v_n_ord      TYPE          znum_ord.


* CONTROLLI SUL MANDATO

  " faccio i controlli solo se è un mandato sostituito
  CHECK s_liq_new-nr_mandato_sost IS NOT INITIAL.

****************************************************************
*1  Il mandato sostituito deve essere annullato                *
****************************************************************

  SELECT SINGLE * FROM zfm_liq_t                     "#EC CI_SEL_NESTED
    INTO @s_liq_sost                          "#EC CI_ALL_FIELDS_NEEDED
    WHERE fikrs        EQ @p_fikrs
    AND   nr_mandato   EQ @s_liq_new-nr_mandato_sost
    AND   anno_mandato EQ @s_liq_new-anno_mandato_sost
    AND   stato        EQ 'A'.

  IF sy-subrc <> 0.
    gv_err = abap_true.
    PERFORM gestisci_errore USING TEXT-019  gc_icon_e.
    RETURN.
  ENDIF.

****************************************************************
*2  Il mandato sostituito deve essere quietanziato             *
****************************************************************

  SELECT * FROM zfm_liq_r                            "#EC CI_SEL_NESTED
    INTO TABLE @t_liq_r_sost                  "#EC CI_ALL_FIELDS_NEEDED
    WHERE fikrs  EQ @s_liq_sost-fikrs
    AND   aa_liq EQ @s_liq_sost-aa_liq
    AND   n_liq  EQ @s_liq_sost-n_liq.

  IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

  LOOP AT t_liq_r_sost ASSIGNING <r>.

    IF <r>-numero_quietanza IS INITIAL
    OR <r>-data_quietanza   IS INITIAL
    OR <r>-imp_quiet NE <r>-importo_r.

      gv_err = abap_true.

      PERFORM gestisci_errore USING TEXT-020  gc_icon_e.

      RETURN.                                           "#EC CI_NOORDER

    ENDIF.

  ENDLOOP.

****************************************************************
* 3	Il nuovo mandato ed il vecchio devono far riferimento      *
* allo stesso esercizio.                                       *
****************************************************************

  IF s_liq_new-anno_mandato NE s_liq_new-anno_mandato_sost.

    gv_err = abap_true.

    PERFORM gestisci_errore USING TEXT-021
                                  gc_icon_e.

    RETURN.

  ENDIF.

****************************************************************
* 4 Le anagrafiche di riferimento (beneficiario originario,    *
* beneficiario alternativo e cliente delle reversali vincolate)*
* devono essere uguali tra nuovo e vecchio mandato.            *
****************************************************************

  SELECT SINGLE * FROM zfm_liq_r              "#EC CI_ALL_FIELDS_NEEDED
    INTO @s_liq_r_new                                "#EC CI_SEL_NESTED
    WHERE fikrs      EQ @s_liq_new-fikrs
    AND   aa_liq     EQ @s_liq_new-aa_liq
    AND   n_liq      EQ @s_liq_new-n_liq
    AND   n_riga_liq EQ 1.
  IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

  READ TABLE t_liq_r_sost ASSIGNING <r> INDEX 1.        "#EC CI_NOORDER

  IF s_liq_r_new-num_ben NE <r>-num_ben.

    gv_err = abap_true.

    PERFORM gestisci_errore USING TEXT-022
                                  gc_icon_e.

    RETURN.


  ENDIF.

  IF s_liq_r_new-ben_alt NE <r>-ben_alt.

    gv_err = abap_true.

    PERFORM gestisci_errore USING TEXT-022
                                  gc_icon_e.

    RETURN.

  ENDIF.


* CONTROLLI SULLE REVERSALI VINCOLATE

  MOVE s_liq_new-nr_mandato TO v_n_ord.

  CALL FUNCTION 'Z_GET_ORDINATIVI_ASSOCIATI'
    EXPORTING
      numero_ordinativo    = v_n_ord
      tipo_ordinativo      = 'M'
      esercizio            = s_liq_new-anno_mandato
    IMPORTING
      ordinativi_associati = t_ordinativi.

  LOOP AT t_ordinativi ASSIGNING <ord>.

    SELECT SINGLE * FROM zfm_rev_t                   "#EC CI_SEL_NESTED
      INTO @s_rev
      WHERE fikrs  EQ @p_fikrs
      AND   gjahr  EQ @<ord>-aa_ord
      AND   n_rev  EQ @<ord>-n_ord.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    APPEND s_rev TO t_rev_new.

  ENDLOOP.

  MOVE s_liq_sost-nr_mandato TO v_n_ord.

  REFRESH t_ordinativi.

  CALL FUNCTION 'Z_GET_ORDINATIVI_ASSOCIATI'
    EXPORTING
      numero_ordinativo    = v_n_ord
      tipo_ordinativo      = 'M'
      esercizio            = s_liq_sost-anno_mandato
    IMPORTING
      ordinativi_associati = t_ordinativi.

  LOOP AT t_ordinativi ASSIGNING <ord>.

    SELECT SINGLE * FROM zfm_rev_t            "#EC CI_ALL_FIELDS_NEEDED
       INTO @s_rev                                   "#EC CI_SEL_NESTED
      WHERE fikrs  EQ @p_fikrs
      AND   gjahr  EQ @<ord>-aa_ord
      AND   n_rev  EQ @<ord>-n_ord.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    APPEND s_rev TO t_rev_sost.

  ENDLOOP.

  " se non hanno reversali è inutile fare altri controlli
  CHECK t_rev_new IS NOT INITIAL OR t_rev_sost IS NOT INITIAL.

  LOOP AT t_rev_new ASSIGNING <rev>.

****************************************************************
* 7 Il riferimento delle nuove reversali vincolate alla        *
* coppia ‘reversale sostituita’ e ‘anno reversale sostituita’  *
* devono esser solo su reversali vincolate associate           *
* al vecchio mandato                                           *
****************************************************************

    " cerco la reversale sostituita
    " se non la trovo segnalo l'errore
    READ TABLE t_rev_sost ASSIGNING <sost>               "#EC CI_STDSEQ
    WITH KEY gjahr = <rev>-anno_reversale_sost
             n_rev = <rev>-nr_reversale_sost.

    IF sy-subrc <> 0.

      gv_err = abap_true.

      PERFORM gestisci_errore USING TEXT-026      gc_icon_e.
      RETURN.
    ENDIF.

