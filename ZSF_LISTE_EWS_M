*----------------------------------------------------------------------*
FORM chiudi_lista  USING lv_stato_lista.
  DATA ls_zfm_lo    TYPE zfm_listeord_ews.
  DATA ls_zfm_liq_t TYPE zfm_liq_t.
  DATA ls_zfm_rev_t TYPE zfm_rev_t.
  DATA lv_ok(1).
  DATA lv_blart     LIKE bkpf-blart.

  CLEAR gs_zmel_document.

* START EB19042016
*********************************************************************************
* INSERIMENTO IN LISTE DET                                                      *
*********************************************************************************
  LOOP AT gt_zmel_document INTO gs_zmel_document.

    PERFORM inserisci_dettaglio USING lv_stato_lista
                                     gs_zmel_document.
  ENDLOOP.
* END EB19042016

********************************************************************************
* aggiorno stato lista di ogni ordinativo incluso nella lista                  *
********************************************************************************
  SELECT * FROM zmel_document INTO gs_zmel_document WHERE n_lista EQ gv_n_lista.

    gs_zmel_document-stato_lista = lv_stato_lista.
* START EB24032016
    IF lv_stato_lista EQ 'LF'.
      gs_zmel_document-trasmesso   = 'X'.
    ENDIF.
* END EB24032016


    MODIFY zmel_document FROM gs_zmel_document.     "#EC CI_IMUD_NESTED
    IF sy-subrc <> 0.

      lv_ok = 'X'.

    ENDIF.
    CLEAR gs_zmel_document.

  ENDSELECT.

  IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

  IF lv_ok IS INITIAL.
    LOOP AT gt_zmel_document INTO gs_zmel_document.

      gs_zmel_document-stato_lista = lv_stato_lista.
      MODIFY gt_zmel_document FROM gs_zmel_document.

*-- LM042021 da eliminare
      COMMIT WORK AND WAIT.

      SELECT SINGLE * FROM zfm_rev_t                 "#EC CI_SEL_NESTED
      INTO @ls_zfm_rev_t
      WHERE fikrs EQ @p_fikrs
      AND   n_rev EQ @gs_zmel_document-numero_ordinativo
      AND   gjahr EQ @gs_zmel_document-gjahr.

      IF sy-subrc IS INITIAL.
        ls_zfm_rev_t-zsfstlista = lv_stato_lista.
*
*Start del GM191121 - Rimosso perchè duplicato (lo esegue successivamente)
** arosati 18.11.2021 ini
*        IF ls_zfm_rev_t-stato = 'A'.
*
*          PERFORM spareggio USING ls_zfm_rev_t.
*        ELSE.
*          PERFORM call_pgm_incassi USING ls_zfm_rev_t.
*        ENDIF.
** arosati 18.11.2021 fine
*End   del GM191121 - Rimosso perchè duplicato (lo esegue successivamente)
      ENDIF.
*-- LM052021 - ADC
*      IF gs_zmel_document-blart = 'M'.
*        CLEAR lv_blart.
*        SELECT SINGLE blart INTO lv_blart
*                            FROM bkpf
*                           WHERE bukrs = ls_zfm_rev_t-bukrs
*                             AND belnr = ls_zfm_rev_t-num_doc_fi.
*        IF lv_blart = '22'.
*
*          PERFORM call_pgm_quiet USING gs_zmel_document-numero_ordinativo
*                                       gs_zmel_document-gjahr
*                                       p_fikrs.
*        ENDIF.
*      ENDIF.
*-- fino qui

    ENDLOOP.
  ENDIF.
******************************************************************************
*aggiorno stato lista nella testata della lista                              *
******************************************************************************
  IF lv_ok IS INITIAL.
    SELECT SINGLE * FROM zfm_listeord_ews
      INTO @ls_zfm_lo
      WHERE zsfnlista EQ @gv_n_lista.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    ls_zfm_lo-zsfstlista = lv_stato_lista.
    ls_zfm_lo-zsfdtst = sy-datum.
    ls_zfm_lo-zsforast = sy-timlo.
    ls_zfm_lo-zsfutente = sy-uname.

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

    MODIFY zfm_listeord_ews FROM ls_zfm_lo.

    IF sy-subrc <> 0.
      ROLLBACK WORK.
      lv_ok = 'X'.
    ELSE.
*   valorizzo ZFM_LISTEDET_EWS per tutti i tipi di lista
    ENDIF.
  ENDIF.

******************************************************************************
* aggiorno stato lista nella testata delle liquidazioni                      *
******************************************************************************
  IF lv_ok IS INITIAL.
    IF lv_stato_lista EQ 'LF'.

      LOOP AT gt_zmel_document INTO gs_zmel_document.

        IF gs_zmel_document-blart EQ 'M'.

*          SELECT SINGLE * FROM zfm_liq_t             "#EC CI_SEL_NESTED
*            INTO @ls_zfm_liq_t
*          WHERE fikrs             EQ @p_fikrs
*          AND   nr_mandato        EQ @gs_zmel_document-numero_ordinativo
*          AND   anno_mandato      EQ @gs_zmel_document-gjahr.

          SELECT * FROM  zfm_liq_t     UP TO 1 ROWS  "#EC CI_SEL_NESTED
            INTO @ls_zfm_liq_t
                WHERE fikrs             EQ @p_fikrs
                AND   nr_mandato        EQ @gs_zmel_document-numero_ordinativo
                AND   anno_mandato      EQ @gs_zmel_document-gjahr
          ORDER BY PRIMARY KEY      .
          ENDSELECT.

          IF sy-subrc EQ 0.

            ls_zfm_liq_t-zsfstlista = 'LF'.
            MODIFY zfm_liq_t FROM ls_zfm_liq_t.     "#EC CI_IMUD_NESTED
            IF sy-subrc <> 0.
              UPDATE zfm_mand_t SET zsfstlista = 'LF' "#EC CI_IMUD_NESTED
              WHERE  fikrs            EQ @p_fikrs
              AND   nr_mandato        EQ @gs_zmel_document-numero_ordinativo
              AND   anno_mandato      EQ @gs_zmel_document-gjahr.
              IF sy-subrc EQ 0.
                lv_ok = 'X'.
              ENDIF.

            ENDIF.

          ENDIF.
        ELSE.

          SELECT SINGLE * FROM zfm_rev_t             "#EC CI_SEL_NESTED
          INTO @ls_zfm_rev_t
          WHERE fikrs EQ @p_fikrs
          AND   n_rev EQ @gs_zmel_document-numero_ordinativo
          AND   gjahr EQ @gs_zmel_document-gjahr.

          IF sy-subrc EQ 0.

            ls_zfm_rev_t-zsfstlista = 'LF'.
            MODIFY zfm_rev_t FROM ls_zfm_rev_t.     "#EC CI_IMUD_NESTED

            IF sy-subrc <> 0.
              lv_ok = 'X'.
            ENDIF.

*-- LM042021
            COMMIT WORK AND WAIT.
* arosati 18.11.2021 ini
            IF ls_zfm_rev_t-stato = 'A'.

              PERFORM spareggio USING ls_zfm_rev_t.
            ELSE.
              PERFORM call_pgm_incassi USING ls_zfm_rev_t.
            ENDIF.
* arosati 18.11.2021 fine
*-- LM052021 - ADC
            IF gs_zmel_document-blart = 'M'.
              CLEAR lv_blart.

              IF ls_zfm_rev_t-num_doc_mm IS INITIAL.
                SELECT SINGLE blart INTO @lv_blart   "#EC CI_SEL_NESTED
                                    FROM bkpf
                                   WHERE bukrs = @ls_zfm_rev_t-bukrs
                                     AND belnr = @ls_zfm_rev_t-num_doc_fi.
                IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

* Start ins LS310821
              ELSE.
                SELECT SINGLE blart FROM rbkp INTO @lv_blart "#EC CI_SEL_NESTED
                WHERE belnr EQ @ls_zfm_rev_t-num_doc_mm
                AND   bukrs EQ '1000'.
                IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA
              ENDIF.
* End   ins LS310821

              IF lv_blart = '22'.
                PERFORM call_pgm_quiet USING gs_zmel_document-numero_ordinativo
                                             gs_zmel_document-gjahr
                                             p_fikrs.
              ENDIF.
            ENDIF.

*--
          ENDIF.


        ENDIF.

      ENDLOOP.


    ENDIF.
  ENDIF.


******************************************************************************
* commit work o rollback                                                     *
******************************************************************************
  IF lv_ok IS INITIAL.

    COMMIT WORK.

  ELSE.

    ROLLBACK WORK.

  ENDIF.



ENDFORM.                    " CHIUDI_LISTA

