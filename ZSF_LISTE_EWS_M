*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_BELNR    text
*      -->P_GJAHR    text
*      -->P_KUNNR    text
*----------------------------------------------------------------------*
FORM ottieni_creditore USING p_belnr TYPE belnr_d
      p_gjahr TYPE gjahr
      p_kunnr TYPE kunnr
      p_aa_prerev  TYPE zfm_rev_t-gjahr       "Ins GM130121
      p_num_prerev TYPE zfm_rev_t-n_pre_rev   "Ins GM130121
      p_stato TYPE zfm_rev_t-stato            "Ins LS230421
      p_subrc TYPE sy-subrc. "ins eb070716

  SELECT SINGLE kunnr                                "#EC CI_SEL_NESTED
  FROM   bseg
  INTO   @p_kunnr
  WHERE  bukrs EQ @p_fikrs
  AND    gjahr EQ @p_gjahr
  AND    belnr EQ @p_belnr
  AND    buzei EQ 1.

** INI arosati 28.09.2021 asterisco questa parte perchè è solo per POLIS,
* ARPA ha logiche diverse sull'iva vedi accesso alla bseg senza
* accertamento non trova mai il kunr corretto
*
  p_subrc = sy-subrc. "ins eb070716

*Start ins GM130121
*Caso dovuto a problemi di orchestratore
  DATA: ls_rev_t   TYPE zfm_rev_t,
        ls_liq_rev TYPE zfm_liq_rev,
        ls_liq_r   TYPE zfm_liq_r,
        ls_autpg   TYPE zfm_autpg_logica,
        lv_data_i  TYPE d,
        lv_data_f  TYPE d.

  SELECT SINGLE * FROM  zfm_rev_t                    "#EC CI_SEL_NESTED
         INTO @ls_rev_t                       "#EC CI_ALL_FIELDS_NEEDED
         WHERE  fikrs      EQ @p_fikrs
         AND    gjahr      EQ @p_aa_prerev
         AND    n_pre_rev  EQ @p_num_prerev.
  IF sy-subrc IS INITIAL.
    "In caso di accertamento su AUTPGLOGICA in prod (con le versioni di Q no ma sono cr ferme)
    "i documenti sono su versante generico
    "Vado a metterci il beneficiario della liq collegata
    CONCATENATE p_aa_prerev '0101' INTO lv_data_i.
    CONCATENATE p_aa_prerev '1231' INTO lv_data_f.

*    SELECT SINGLE * FROM  zfm_autpg_logica           "#EC CI_SEL_NESTED
*           INTO @ls_autpg                     "#EC CI_ALL_FIELDS_NEEDED
*           WHERE  databis     GE @lv_data_f
*           AND    datab       LE @lv_data_i
*           AND    n_accert    EQ @ls_rev_t-n_accert
*           AND    pos_accert  EQ @ls_rev_t-pos_accert.


    SELECT  * FROM   zfm_autpg_logica    UP TO 1 ROWS "#EC CI_SEL_NESTED
   INTO @ls_autpg                             "#EC CI_ALL_FIELDS_NEEDED
   WHERE  databis     GE @lv_data_f
   AND    datab       LE @lv_data_i
   AND    n_accert    EQ @ls_rev_t-n_accert
   AND    pos_accert  EQ @ls_rev_t-pos_accert
ORDER BY PRIMARY KEY      .
    ENDSELECT.



    IF sy-subrc IS INITIAL.
      "Ok, autpglogica
      "Recupero la liq
      SELECT SINGLE * FROM  zfm_liq_rev              "#EC CI_SEL_NESTED
             INTO @ls_liq_rev                 "#EC CI_ALL_FIELDS_NEEDED
             WHERE  fikrs      EQ @p_fikrs
             AND    aa_rev     EQ @p_aa_prerev
             AND    n_pre_rev  EQ @p_num_prerev.
      IF sy-subrc IS INITIAL.
        "Mi recupero il beneficiario dalla rev
        SELECT SINGLE * FROM  zfm_liq_r              "#EC CI_SEL_NESTED
               INTO @ls_liq_r                 "#EC CI_ALL_FIELDS_NEEDED
               WHERE  fikrs       EQ @p_fikrs
               AND    aa_liq      EQ @ls_liq_rev-aa_liq
               AND    n_liq       EQ @ls_liq_rev-n_liq
               AND    n_riga_liq  EQ 1.
        IF sy-subrc IS INITIAL.
          p_kunnr = ls_liq_r-num_ben.
        ENDIF.
      ENDIF.
    ENDIF.

    p_stato = ls_rev_t-stato. "Ins LS230421
  ENDIF.

  IF p_kunnr IS INITIAL.
    p_subrc = '4'.
  ENDIF.
*End   ins GM130121

** FINE arosati 28.09.2021
ENDFORM.                    "ottieni_creditore
