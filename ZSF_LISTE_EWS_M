        IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

      ENDLOOP .
ENDFORM.                    "recupera_grid
*End   ins GM050521
FORM spareggio  USING    p_rev_t TYPE zfm_rev_t.

  DATA : tb_zfm_rev_r LIKE zfm_rev_r OCCURS 0 WITH HEADER LINE,
         gs_zfm_rev_r LIKE zfm_rev_r,
         doc_storno   TYPE  belnr_d,anno_storno TYPE stjah. "arosati

  SELECT *
        FROM zfm_rev_r                               "#EC CI_SEL_NESTED
        INTO CORRESPONDING FIELDS OF TABLE @tb_zfm_rev_r "#EC CI_ALL_FIELDS_NEEDED
       WHERE fikrs     = @p_rev_t-fikrs
         AND gjahr     = @p_rev_t-gjahr         " anno
         AND n_pre_rev = @p_rev_t-n_pre_rev.    " numero per

    IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA
    CLEAR gs_zfm_rev_r.

    LOOP AT tb_zfm_rev_r INTO gs_zfm_rev_r.

      IF gs_zfm_rev_r-anno_paregg_parz IS NOT INITIAL
        AND gs_zfm_rev_r-doc_paregg_parz IS NOT INITIAL.

*        clear doc_storno.
        CALL FUNCTION 'CALL_FB08'
          EXPORTING
            i_bukrs      = gs_zfm_rev_r-fikrs
            i_belnr      = gs_zfm_rev_r-doc_paregg_parz
            i_gjahr      = gs_zfm_rev_r-anno_paregg_parz
            i_stgrd      = '01'
          EXCEPTIONS
            not_possible = 1
            OTHERS       = 2.
        IF sy-subrc EQ 0.
          UPDATE zfm_rev_r SET doc_paregg_parz = ' ' "#EC CI_IMUD_NESTED
                               anno_paregg_parz = ' '
           WHERE fikrs     =  p_rev_t-fikrs
            AND gjahr     = p_rev_t-gjahr   " anno
            AND n_pre_rev = p_rev_t-n_pre_rev
            AND n_riga    =  gs_zfm_rev_r-n_riga.  " numero per
          IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA
        ENDIF.
      ENDIF.

      IF gs_zfm_rev_r-num_doc_par  IS NOT INITIAL
          AND gs_zfm_rev_r-aa_doc_par IS NOT INITIAL.

        CLEAR doc_storno.
        CALL FUNCTION 'ZFM_FBRA'
          EXPORTING
            i_gjahr = gs_zfm_rev_r-aa_doc_par
            i_belnr = gs_zfm_rev_r-num_doc_par
          IMPORTING
            e_stblg = doc_storno
            e_stjah = anno_storno.
        IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA
        IF doc_storno NE space.
          UPDATE zfm_rev_r SET aa_doc_par = ' '     "#EC CI_IMUD_NESTED
                               num_doc_par = ' '
             WHERE fikrs    =  p_rev_t-fikrs
              AND gjahr     =  p_rev_t-gjahr   " anno
              AND n_pre_rev =  p_rev_t-n_pre_rev
              AND n_riga    =  gs_zfm_rev_r-n_riga.  " numero per
          IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA
        ENDIF.
      ENDIF.

    ENDLOOP.

ENDFORM.                    " CALL_spareggio
