*&---------------------------------------------------------------------*
*&      Form  SCARTA_ORDINATIVI_ERRATI
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_GS_ORD_EWS_BELNR  text
*      -->P_GS_ORD_EWS_GJAHR  text
*      -->P_6861   text
*----------------------------------------------------------------------*
FORM scarta_ordinativi_errati  USING    lv_belnr     TYPE znum_ord
      lv_gjahr     TYPE gjahr
      lv_blart     TYPE blart
      iv_data      TYPE d "Ins GM230824
      lv_imputaz   TYPE ztipo_imputaz
      lv_tipo_liq  TYPE ztp_liq
      lv_mod_pag   TYPE schzw_bseg
      lv_copertura TYPE zmandacop
      lv_stato     TYPE z_stato
      lv_tipo_rev  TYPE ztp_rev
      lt_associata TYPE z_t_ordinativi.
************************************************************************
* verifica degli ordinativi da scartare per tipo_imputazione scorretto *
************************************************************************
  DATA: lt_int_ass   TYPE z_t_ordinativi.
  DATA: ls_imputaz   TYPE zsf_imputaz.
  DATA: ls_associata TYPE zordinativi.
  DATA: ls_liq_t     TYPE zfm_liq_t.
  DATA: ls_liq_r     TYPE zfm_liq_r.
  DATA: ls_rev_t     TYPE zfm_rev_t.
  DATA: ls_liq_rev   TYPE zfm_liq_rev.
  DATA: lv_num_ord   TYPE znum_ord.

  CASE lv_blart.

    WHEN 'M'.
************************************************************************
*      MANDATO                                                         *
************************************************************************

      SELECT SINGLE * FROM zsf_imputaz               "#EC CI_SEL_NESTED
        INTO @ls_imputaz                      "#EC CI_ALL_FIELDS_NEEDED
      WHERE  tipo_flusso EQ 'U'
      AND   tipo_imputaz EQ @lv_imputaz
      AND   tipo_liq     EQ @lv_tipo_liq
      AND   mod_pag      EQ @lv_mod_pag
      AND   copertura    EQ @lv_copertura
*Start ins GM230824 - Data validità
       AND   inizio_val   LE @iv_data
       AND   fine_val     GE @iv_data.
*End   ins GM230824 - Data validità

      IF sy-subrc <> 0.
        gv_err = 'X'.
        PERFORM gestisci_errore USING TEXT-004
              gc_icon_e.
      ELSE.
        LOOP AT lt_associata INTO ls_associata.    "#EC CI_LOOP_INTO_WA

          SELECT SINGLE * FROM zfm_rev_t             "#EC CI_SEL_NESTED
          INTO @ls_rev_t                      "#EC CI_ALL_FIELDS_NEEDED
          WHERE gjahr  EQ @ls_associata-aa_ord
          AND   n_rev  EQ @ls_associata-n_ord
          AND   fikrs  EQ @p_fikrs.

          IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

          SELECT SINGLE * FROM zfm_liq_rev           "#EC CI_SEL_NESTED
          INTO @ls_liq_rev                    "#EC CI_ALL_FIELDS_NEEDED
          WHERE fikrs  EQ @p_fikrs
          AND   aa_rev EQ @ls_rev_t-gjahr
          AND   n_rev  EQ @ls_rev_t-n_rev.

          IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

          CLEAR ls_imputaz.

          SELECT SINGLE * FROM zsf_imputaz           "#EC CI_SEL_NESTED
            INTO @ls_imputaz                  "#EC CI_ALL_FIELDS_NEEDED
          WHERE tipo_flusso  EQ 'E'
            AND tipo_imputaz EQ @ls_liq_rev-tipo_imputaz
            AND tipo_rev     EQ @ls_rev_t-tipo_rev
*Start ins GM230824 - Data validità
       AND   inizio_val   LE @ls_rev_t-dt_rev
       AND   fine_val     GE @ls_rev_t-dt_rev.
*End   ins GM230824 - Data validità

          IF sy-subrc <> 0.
            gv_err = 'X'.
            PERFORM gestisci_errore USING TEXT-004
                  gc_icon_e.
          ENDIF.

* Start ins LS230421
          " Se il mandato è in stato annullato procedo con l'invio
          " solo se tutte le rev sono in stato annullato
          IF  ls_rev_t-stato NE 'A'
          AND lv_stato EQ 'A'.
            gv_err = 'X'.
            PERFORM gestisci_errore USING TEXT-037
                  gc_icon_e.
            EXIT.
          ENDIF.
* End   ins LS230421
        ENDLOOP.
      ENDIF.

    WHEN 'RM'.
************************************************************************
*   REVERALE CON MANDATO                                               *
************************************************************************
      SELECT SINGLE * FROM zsf_imputaz               "#EC CI_SEL_NESTED
        INTO @ls_imputaz                      "#EC CI_ALL_FIELDS_NEEDED
      WHERE tipo_flusso  EQ 'E'
      AND   tipo_imputaz EQ @lv_imputaz
      AND   tipo_rev     EQ @lv_tipo_rev
*Start ins GM230824 - Data validità
       AND   inizio_val   LE @iv_data
       AND   fine_val     GE @iv_data.
*End   ins GM230824 - Data validità

      IF sy-subrc <> 0.
        gv_err = 'X'.
        PERFORM gestisci_errore USING TEXT-004             gc_icon_e.
      ENDIF.

      IF gv_err IS INITIAL.

        READ TABLE lt_associata INTO ls_associata WITH KEY tipo_ord = 'M'. "#EC CI_STDSEQ

        SELECT SINGLE * FROM zfm_liq_t               "#EC CI_SEL_NESTED
        INTO  @ls_liq_t                       "#EC CI_ALL_FIELDS_NEEDED
        WHERE fikrs        EQ @p_fikrs
        AND   anno_mandato EQ @ls_associata-aa_ord
        AND   nr_mandato   EQ @ls_associata-n_ord.

        IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

        SELECT SINGLE * FROM zfm_liq_r               "#EC CI_SEL_NESTED
        INTO  @ls_liq_r                       "#EC CI_ALL_FIELDS_NEEDED
        WHERE fikrs        EQ @p_fikrs
        AND   aa_liq       EQ @ls_liq_t-aa_liq
        AND   n_liq        EQ @ls_liq_t-n_liq
        AND   n_riga_liq   EQ 1.

        IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

* START INS EB200616
        IF ls_liq_r-mod_pag IS INITIAL AND
           ls_liq_r-mod_pag_alt IS NOT INITIAL..
          ls_liq_r-mod_pag = ls_liq_r-mod_pag_alt.
        ENDIF.
* End EB200616

*        SELECT SINGLE * FROM zsf_imputaz             "#EC CI_SEL_NESTED
*          INTO @ls_imputaz                    "#EC CI_ALL_FIELDS_NEEDED
*        WHERE  tipo_flusso EQ 'U'
*        AND   tipo_imputaz EQ @ls_liq_t-tipo_imputaz
*        AND   tipo_liq     EQ @ls_liq_t-tipo_liq
*        AND   mod_pag      EQ @ls_liq_r-mod_pag
*        AND   copertura    EQ @ls_liq_t-mandato_copertura.

        IF sy-subrc <> 0.
*          gv_err = 'X'.
*          PERFORM gestisci_errore USING TEXT-004                gc_icon_e.
        ELSE.

          lv_num_ord = ls_liq_t-nr_mandato.

          CALL FUNCTION 'Z_GET_ORDINATIVI_ASSOCIATI'
            EXPORTING
              numero_ordinativo    = lv_num_ord
              tipo_ordinativo      = 'M'
              esercizio            = ls_liq_t-anno_mandato
*             REV_DELLE_REV        =
            IMPORTING
              ordinativi_associati = lt_int_ass
*             N_ORD_ASSOCIATI      =
            .


          LOOP AT lt_int_ass INTO ls_associata.

            SELECT SINGLE * FROM zfm_rev_t           "#EC CI_SEL_NESTED
            INTO @ls_rev_t                    "#EC CI_ALL_FIELDS_NEEDED
            WHERE gjahr  EQ @ls_associata-aa_ord
            AND   n_rev  EQ @ls_associata-n_ord
            AND   fikrs  EQ @p_fikrs.

            IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

            SELECT SINGLE * FROM zfm_liq_rev         "#EC CI_SEL_NESTED
            INTO @ls_liq_rev                  "#EC CI_ALL_FIELDS_NEEDED
            WHERE fikrs  EQ @p_fikrs
            AND   aa_rev EQ @ls_rev_t-gjahr
            AND   n_rev  EQ @ls_rev_t-n_rev.

            IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

            CLEAR ls_imputaz.

            SELECT SINGLE * FROM zsf_imputaz         "#EC CI_SEL_NESTED
              INTO @ls_imputaz                "#EC CI_ALL_FIELDS_NEEDED
            WHERE tipo_flusso  EQ 'E'
            AND   tipo_imputaz EQ @ls_liq_rev-tipo_imputaz
            AND   tipo_rev     EQ @ls_rev_t-tipo_rev
*Start ins GM230824 - Data validità
            AND   inizio_val   LE @iv_data
            AND   fine_val     GE @iv_data.
*End   ins GM230824 - Data validità
            IF sy-subrc <> 0.
              gv_err = 'X'.
              PERFORM gestisci_errore USING TEXT-004                    gc_icon_e.
            ENDIF.
          ENDLOOP.

        ENDIF.
      ENDIF.

    WHEN 'R'.
************************************************************************
*      REVERSALE                                                       *
************************************************************************

      SELECT SINGLE * FROM zsf_imputaz               "#EC CI_SEL_NESTED
        INTO @ls_imputaz                      "#EC CI_ALL_FIELDS_NEEDED
      WHERE tipo_flusso  EQ 'E'
      AND   tipo_imputaz EQ @lv_imputaz
      AND   tipo_rev     EQ @lv_tipo_rev
*Start ins GM230824 - Data validità
       AND   inizio_val   LE @iv_data
       AND   fine_val     GE @iv_data.
*End   ins GM230824 - Data validità
      IF sy-subrc <> 0.
        gv_err = 'X'.
        PERFORM gestisci_errore USING TEXT-004              gc_icon_e.
      ENDIF.


  ENDCASE.

ENDFORM.                    " SCARTA_ORDINATIVI_ERRATI
