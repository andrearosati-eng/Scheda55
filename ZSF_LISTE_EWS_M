FORM prendi_numero_lista  USING p_lv_n_lista.
  DATA: lv_stato_lista TYPE zfmstlista.
  "prendo il maggiore numero lista (l'ultimo) dalla zmel_document
  SELECT MAX( zsfnlista )  FROM zfm_listeord_ews INTO @p_lv_n_lista. "#EC CI_NOWHERE

  IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

  SELECT SINGLE zsfstlista FROM zfm_listeord_ews
    INTO @lv_stato_lista
     WHERE  bukrs     EQ 1000
       AND  gjahr     EQ @p_lv_n_lista(4)
       AND  zsfnlista EQ @p_lv_n_lista.

  IF sy-subrc = 0.ELSE.ENDIF. " MIGRAZIONE SAP4HANA

  IF lv_stato_lista NE 'LA'. "se l'ultima lista non è aperta

    IF sy-datum(4) NE p_lv_n_lista(4). "il range di numerazione deve ripartire
      CONCATENATE sy-datum(4) '00001' INTO p_lv_n_lista.
    ELSE. "il range di numerazione c'è già e quindi aggiungo 1
      ADD 1 TO p_lv_n_lista.
    ENDIF.

  ENDIF. "altrimenti mi va bene l'ultima creata

  IF p_lv_n_lista IS INITIAL. "nel db non ci sono ancora numeri lista
    CONCATENATE sy-datum(4) '00001' INTO p_lv_n_lista.
  ENDIF.


