*<--fdc_MEV29 - - parametrizzazione TD*
  REFRESH: r_op_doc_ft, r_op_doc_nc, tb_op_doc.
  SELECT * FROM zfm_tipi_op_doc INTO CORRESPONDING FIELDS OF TABLE tb_op_doc.
  SORT tb_op_doc BY tipo_op zeconomo.
  LOOP AT tb_op_doc.
    IF tb_op_doc-fattura = 'X'.
      r_op_doc_ft-option = 'EQ'.
      r_op_doc_ft-sign   = 'I'.
      r_op_doc_ft-low    = tb_op_doc-tipo_op.
      APPEND r_op_doc_ft. CLEAR r_op_doc_ft.
    ELSE.
      r_op_doc_nc-option = 'EQ'.
      r_op_doc_nc-sign   = 'I'.
      r_op_doc_nc-low    = tb_op_doc-tipo_op.
      APPEND r_op_doc_nc. CLEAR r_op_doc_nc.
    ENDIF.
  ENDLOOP.
  SORT r_op_doc_ft. SORT r_op_doc_nc.
  DELETE ADJACENT DUPLICATES FROM r_op_doc_ft.
  DELETE ADJACENT DUPLICATES FROM r_op_doc_nc.
*-->fdc_MEV29

********************************************
*  AT SELECTION-SCREEN OUTPUT              *
********************************************
AT SELECTION-SCREEN OUTPUT.

* Gestione tabstrip per mandati
  IF p_mand IS INITIAL.

    LOOP AT SCREEN.

      IF screen-name CS 'LIQ'.

        screen-active    = '0'.

      ENDIF.

      MODIFY SCREEN.

    ENDLOOP.

  ENDIF.

* Gestione tabstrip per reversali
  IF p_att IS INITIAL.

    LOOP AT SCREEN.
      IF screen-name CS 'REV'.
        screen-active    = '0'.
      ENDIF.
      MODIFY SCREEN.
    ENDLOOP.

  ENDIF.

*quando entrambe le checkbox non sono selezionate verrà rimossa la subscreen
  IF p_mand IS INITIAL AND p_att IS INITIAL.

    LOOP AT SCREEN.
      IF screen-name EQ 'BUTTON1' OR screen-name EQ 'BUTTON2'.
        screen-active = '0'.
      ENDIF.
      MODIFY SCREEN.
    ENDLOOP.

  ENDIF.

  IF p_mand IS NOT INITIAL
  AND p_att IS INITIAL.

    sb_selezione-activetab = 'PUSH1'.
    sb_selezione-dynnr     = '100'.

  ENDIF.

  IF p_mand IS  INITIAL
AND p_att IS NOT INITIAL.

    sb_selezione-activetab = 'PUSH2'.
    sb_selezione-dynnr     = '101'.

  ENDIF.

